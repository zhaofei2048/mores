Cell["Step 1. Load the bistatic scattering program- IEMM", "Section",
 Evaluatable->False,
 TextAlignment->Left,
 TextJustification->0,
 AspectRatioFixed->True,
 FontSize->18,
 FontColor->RGBColor[
  1, 0, 1],ExpressionUUID->"82d42296-a81c-4bf7-ba22-acf712cecde7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Off", "[", 
   RowBox[{"General", "::", "\"\<spell1\>\""}], "]"}], ";", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Off", "[", 
     RowBox[{"General", "::", "\"\<spell\>\""}], "]"}], ";"}], ")"}]}], "\n", 
 RowBox[{
  RowBox[{"BeginPackage", "[", "\"\<IEMM`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"IEMM", "::", "\"\<usage\>\""}], "=", 
   "\"\<Calculates Bistatic Single surface scattering\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Begin", "[", "\"\<`private`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"IEMM", 
   StyleBox["[",
    FontColor->RGBColor[1, 0, 1]], 
   RowBox[{
   "fr_", ",", "sig_", ",", "corr_", ",", "theta_", ",", "ths_", ",", "phs_", 
    ",", "er_", ",", "sp_", ",", "xx_"}], 
   StyleBox["]",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 1]]}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"k", "=", 
      FractionBox[
       RowBox[{"2.0", " ", "\[Pi]", " ", "fr"}], "30.0"]}], ";", 
     RowBox[{"phi", "=", "0.0"}], ";", 
     RowBox[{"\[Sigma]", "=", "sig"}], ";", 
     RowBox[{"L", "=", "corr"}], ";", 
     RowBox[{"\[Mu]r", "=", "1"}], ";", 
     RowBox[{"thetas", "=", "ths"}], ";", "\n", 
     RowBox[{"ks", "=", 
      RowBox[{"k", " ", "sig"}]}], ";", 
     RowBox[{"kL", "=", 
      RowBox[{"k", "*", "corr"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"N", "[", 
       RowBox[{"Sin", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"theta", "+", "0.01"}], ")"}], " ", "Degree"}], "]"}], 
       "]"}]}], ";", "\n", 
     RowBox[{"cs", "=", 
      RowBox[{"N", "[", 
       RowBox[{"Cos", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"theta", "+", "0.01"}], ")"}], " ", "Degree"}], "]"}], 
       "]"}]}], ";", "\n", 
     RowBox[{"sf", "=", 
      RowBox[{"N", "[", 
       RowBox[{"Sin", "[", 
        RowBox[{"phi", " ", "Degree"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"cf", "=", 
      RowBox[{"N", "[", 
       RowBox[{"Cos", "[", 
        RowBox[{"phi", " ", "Degree"}], "]"}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"ss", "=", 
      RowBox[{"N", "[", 
       RowBox[{"Sin", "[", 
        RowBox[{"ths", " ", "Degree"}], "]"}], "]"}]}], ";", 
     RowBox[{"s2", "=", 
      RowBox[{"s", "*", "s"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"css", "=", 
      RowBox[{"N", "[", 
       RowBox[{"Cos", "[", 
        RowBox[{"ths", " ", "Degree"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cfs", "=", 
      RowBox[{"N", "[", 
       RowBox[{"Cos", "[", 
        RowBox[{"phs", " ", "Degree"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"sfs", "=", 
      RowBox[{"N", "[", 
       RowBox[{"Sin", "[", 
        RowBox[{"phs", " ", "Degree"}], "]"}], "]"}]}], ";", "\n", "\n", "  ", 
     RowBox[{"kx", "=", 
      RowBox[{"N", "[", 
       RowBox[{"k", " ", "s", " ", "cf"}], "]"}]}], ";", "       ", 
     RowBox[{"ky", "=", 
      RowBox[{"N", "[", 
       RowBox[{"k", " ", "s", " ", "sf"}], "]"}]}], ";", "      ", 
     RowBox[{"kz", "=", 
      RowBox[{"N", "[", 
       RowBox[{"k", " ", "cs"}], "]"}]}], ";", "\n", 
     RowBox[{"ksx", "=", 
      RowBox[{"N", "[", 
       RowBox[{"k", " ", "ss", " ", "cfs"}], "]"}]}], ";", 
     RowBox[{"ksy", "=", 
      RowBox[{"N", "[", 
       RowBox[{"k", " ", "ss", " ", "sfs"}], "]"}]}], ";", 
     RowBox[{"ksz", "=", 
      RowBox[{"N", "[", 
       RowBox[{"k", " ", "css"}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"rt", "=", 
      SqrtBox[
       RowBox[{"er", "-", 
        SuperscriptBox["s", "2"]}]]}], ";", 
     RowBox[{"Rvi", "=", 
      RowBox[{"N", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"er", " ", "cs"}], "-", "rt"}], 
        RowBox[{
         RowBox[{"er", " ", "cs"}], "+", "rt"}]], "]"}]}], ";", 
     RowBox[{"Rhi", "=", 
      RowBox[{"N", "[", 
       FractionBox[
        RowBox[{"cs", "-", "rt"}], 
        RowBox[{"cs", "+", "rt"}]], "]"}]}], ";", "\[IndentingNewLine]", "\n",
      "\n", 
     RowBox[{"wvnb", "=", 
      RowBox[{"k", " ", 
       RowBox[{"\[Sqrt]", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"ss", " ", "cfs"}], "-", 
             RowBox[{"s", " ", "cf"}]}], ")"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"ss", " ", "sfs"}], "-", " ", 
             RowBox[{"s", " ", "sf"}]}], ")"}], "2"]}], ")"}]}]}]}], ";", 
     "\n", 
     RowBox[{"TS", "=", "1"}], ";", 
     RowBox[{"error", "=", 
      SuperscriptBox["10", "8"]}], ";", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"error", ">", 
        FractionBox["1", 
         SuperscriptBox["10", "8"]]}], ",", 
       RowBox[{
        RowBox[{"TS", "=", 
         RowBox[{"TS", "+", "1"}]}], ";", 
        RowBox[{"error", "=", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["ks", "2"], " ", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"cs", "+", "css"}], ")"}], "2"]}], ")"}], "TS"], 
          RowBox[{"TS", "!"}]]}], ";"}]}], "]"}], ";", "\n", 
     RowBox[{"spctrm", "=", 
      RowBox[{"Switch", "[", 
       RowBox[{"sp", ",", "\n", "\t\t\t           ", "1", ",", 
        RowBox[{"Do", "[", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"w", "[", "n", "]"}], "=", 
