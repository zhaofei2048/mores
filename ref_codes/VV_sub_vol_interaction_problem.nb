        StyleBox[",",
         FontColor->RGBColor[0, 0, 1]], "\n", "\t\t\t\t", "2", ",", 
        RowBox[{"Do", "[", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"w", "[", "n", "]"}], "=", 
           RowBox[{"N", "[", 
            StyleBox[
             RowBox[{
              FractionBox[
               SuperscriptBox["L", "2"], 
               RowBox[{"2", " ", "n"}]], " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"-", 
                FractionBox[
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"wvnb", " ", "L"}], ")"}], "2"], 
                 RowBox[{"4", " ", "n"}]]}], "]"}]}],
             FontColor->RGBColor[0, 0, 1]], 
            StyleBox["]",
             FontColor->RGBColor[0, 0, 1]]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", "TS", ",", "1"}], "}"}]}], "]"}], 
        StyleBox[",",
         FontColor->RGBColor[0, 0, 1]], "\[IndentingNewLine]", "3", ",", 
        RowBox[{"Do", "[", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"w", "[", "n", "]"}], "=", 
           StyleBox[
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"wvnb", "==", "0"}], ",", 
              FractionBox[
               SuperscriptBox["L", "2"], 
               RowBox[{
                RowBox[{"3", " ", "n"}], "-", "2"}]], ",", 
              RowBox[{"N", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  SuperscriptBox["L", "2"], " ", 
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"wvnb", " ", "L"}], ")"}], 
                   RowBox[{
                    RowBox[{"xx", " ", "n"}], "-", "1"}]], " ", 
                  RowBox[{"BesselK", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "xx"}], " ", "n"}], "+", "1"}], ",", 
                    RowBox[{"wvnb", " ", "L"}]}], "]"}]}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{
                  SuperscriptBox["2", 
                   RowBox[{
                    RowBox[{"xx", " ", "n"}], "-", "1"}]], " ", 
                  RowBox[{"Gamma", "[", 
                   RowBox[{"xx", " ", "n"}], "]"}]}], ")"}]}], "]"}]}], "]"}],
            FontColor->RGBColor[0, 0, 1]]}], 
          StyleBox[",",
           FontColor->RGBColor[0, 0, 1]], 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", "TS", ",", "1"}], "}"}]}], "]"}], 
        StyleBox[",",
         FontColor->RGBColor[0, 0, 1]], "\t", "\[IndentingNewLine]", "4", ",", 
        RowBox[{"Do", "[", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"w", "[", "n", "]"}], "=", "  ", 
           StyleBox[
            RowBox[{
             StyleBox[
              FractionBox[
               SuperscriptBox["L", "2"], 
               SuperscriptBox["n", 
                RowBox[{"2", "/", "xx"}]]],
              FontColor->RGBColor[0, 0, 1]], 
             StyleBox["*",
              FontColor->RGBColor[0, 0, 1]], 
             RowBox[{
              StyleBox["NIntegrate",
               FontColor->RGBColor[1, 0, 0]], 
              StyleBox["[",
               FontColor->RGBColor[1, 0, 0]], 
              RowBox[{
               RowBox[{
                StyleBox[
