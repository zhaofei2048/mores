              FontSlant->"Italic"], 
            StyleBox[";",
              FontSlant->"Italic"], "\n", 
            StyleBox[
              RowBox[{"iemmhh", "=", 
                RowBox[{
                "ShdwS", \(k\^2\/2\), \(Exp[\(-\[Sigma]\^2\) \((kz\^2 + 
                          ksz\^2)\)]\), 
                  RowBox[{
                    UnderoverscriptBox["\[Sum]", 
                      RowBox[{"n", "=", 
