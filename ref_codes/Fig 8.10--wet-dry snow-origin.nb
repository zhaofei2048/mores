Cell[BoxData[{
    \(\((1)\)\ This\ is\ the\ Rayleigh\ layer\ model . 
        It\ consists\ of\ a\ top\ surface\ scattering\ term, 
    a\ bottom\ surface\ scattering\ term, \(a\ layer\ volume\ scattering\ \
term\ and\ an\ interaction\ term . \((2)\)\ Exact\ calculation\ should\ use\ \
the\ real\ angle\ of\ transmision\ given\ in\ the\ program\ below . er = 
        relative\ complex\ dielectric\ constant\ of\ the\ layer;\)\), "\n", 
    \(\(erb = 
        relative\ complex\ dielectric\ constant\ of\ the\ half - 
          space\ below\ the\ layer;\)\), "\n", 
    \(\)}], "Input",
  FontSize->18]
}, Closed]],

Cell[CellGroupData[{

Cell["Step 2. Load graphics package", "Section",
  FontSize->18],

Cell[BoxData[{
    \(\(Needs["\<Graphics`MultipleListPlot`\>"];\)\), "\[IndentingNewLine]", 
    \(\(sym1 = PlotSymbol[Diamond, 3];\)\), "\n", 
    \(\(sym2 = PlotSymbol[Triangle, 5];\)\), "\n", 
    \(\(sym3 = PlotSymbol[Star, 2];\)\), "\n", 
    \(\(sym4 = PlotSymbol[Box, 3];\)\), "\[IndentingNewLine]", 
    \(\)}], "Input",
  FontSize->18]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Step 3. Load the Rayleigh Layer Scattering Program
(1) This is the Rayleigh layer model. It consists of a top surface  \
scattering term, a bottom surface scattering term, a layer volume scattering \
term and an interaction term.
(2) Exact calculation should use the real angle of transmision given in the \
program below.
er = relative complex dielectric constant of the layer;
erb=relative complex dielectric constant of the half-space below the layer;
\
\>", "Section",
  FontSize->18],

Cell[BoxData[
    RowBox[{"\[IndentingNewLine]", 
      RowBox[{
        RowBox[{
          
          RowBox[{\(Off[General::"\<spell1\>"]; 
            Off[General::"\<spell\>"]; \n\(BeginPackage["\<Rlay`\>", \
{"\<IEMM`\>", "\<Graphics`MultipleListPlot`\>"}];\)\), 
            "\n", \(Rlay::"\<usage\>" = "\<Calculates Layer volume-surf \
scattering and interaction\>";\), "\n", \(Begin["\<`private`\>"];\), "\n", 
            RowBox[{
              RowBox[{"Rlay", 
                StyleBox["[",
                  FontColor->RGBColor[1, 0, 1]], \(fr_, al_, tau_, theta_, 
                thetas_, phs_, er_, erb_, sig1_, sig2_, L1_, L2_, sp_\), 
                StyleBox["]",
                  FontSlant->"Italic",
                  FontColor->RGBColor[1, 0, 1]]}], ":=", 
              RowBox[{"Module", "[", 
                RowBox[{\({}\), ",", "\[IndentingNewLine]", "\t", 
                  
                  RowBox[{\(k = \((2.0\ Pi\ fr)\)/30.0\), 
                    ";", \(kl = k \@ Re[er]\), ";", "\n", "\t", "\n", 
                    "\t\t", \(cs = N[Cos[theta\ Degree]]\), ";", "\n", 
                    "\t\t", \(s = N[Sin[theta\ Degree]]\), ";", "\n", 
                    "\t\t", \(s2 = s\^2\), ";", "\n", 
                    "\t\t", \(cfs = N[Cos[phs\ Degree]]\), ";", "\n", 
                    "\t\t", \(sfs = N[Sin[phs\ Degree]]\), ";", "\n", 
                    "\t\t", \(css = N[Cos[thetas\ Degree]]\), ";", "\n", 
                    "\t\t", \(ss = N[Sin[thetas\ Degree]]\), ";", "\n", 
                    "\t\t", \(ss2 = ss\^2\), ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", " ", 
                      
                      StyleBox[\(Calculations\ of\ sine\ and\ cosine\ using\ \
real - thetat\ and\ real - thetao\),
                        FontColor->RGBColor[0, 0, 1]], "*)"}], 
                    "\[IndentingNewLine]", \(alf = Im[\@er] // N\), ";", 
                    " ", \(be = Re[\@er]\), ";", " ", \(p = 2\ alf*\ be\), 
                    ";", " ", \(q = be\^2 - alf\^2 - s2\), 
                    ";", \(qs = be\^2 - alf\^2 - ss2\), ";", 
                    "\[IndentingNewLine]", \(tant = 
                      1.414\ s/\@\(q + \@\(p\^2 + q\^2\)\)\), ";", 
                    " ", \(thetat = ArcTan[tant]*180/\[Pi]\), ";", 
                    " ", \(st = Sin[thetat\ Degree] // N\), 
                    ";", \(cst = \@\(1 - st\^2\)\), ";", 
                    "\[IndentingNewLine]", \(tano = 
                      1.414\ ss/\@\(q + \@\(p\^2 + qs\^2\)\)\), ";", 
                    " ", \(thetao = ArcTan[tano]*180/\[Pi]\), ";", 
                    " ", \(so = Sin[thetao\ Degree] // N\), 
                    ";", \(cso = \@\(1 - so\^2\)\), ";", 
                    "\[IndentingNewLine]", "  ", "\n", 
                    RowBox[{"(*", 
                      
                      StyleBox[\(\(\(Top\ boundary\  &\)\ bottom\ \
reflectivity\  &\)\ transmissivity\),
                        FontColor->RGBColor[0, 0, 1]], "*)"}], 
                    "\[IndentingNewLine]", "\t\t", \(rt = \@\(er - s\^2\)\), 
                    ";", \(rvi = N[\(er\ cs - rt\)\/\(er\ cs + rt\)]\), 
                    ";", \(rhi = N[\(cs - rt\)\/\(cs + rt\)]\), 
                    ";", \(Rv = Abs[rvi]\^2\), ";", \(Rh = Abs[rhi]\^2\), ";",
                     "\[IndentingNewLine]", "\t", \(rts = \@\(er - ss\^2\)\), 
                    ";", \(rvs = N[\(er\ css - rts\)\/\(er\ css + rts\)]\), 
                    ";", \(rhs = N[\(css - rts\)\/\(css + rts\)]\), 
                    ";", \(Rvs = Abs[rvs]\^2\), ";", \(Rhs = Abs[rhs]\^2\), 
                    ";", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", \(rtbt = \@\(erb\/er - st\^2\)\), 
                    ";", \(rvt = 
                      N[\(\((erb/er)\)\ cst - rtbt\)\/\(\((erb/er)\)\ cst + \
rtbt\)]\), ";", \(rht = N[\(cst - rtbt\)\/\(cst + rtbt\)]\), 
                    ";", \(Rvt = Abs[rvt]\^2\), ";", \(Rht = Abs[rht]\^2\), 
                    ";", "\[IndentingNewLine]", \(rtbo = \@\(erb\/er - \
so\^2\)\), ";", \(rvo = 
                      N[\(\((erb/er)\)\ cso - rtbo\)\/\(\((erb/er)\)\ cso + \
rtbo\)]\), ";", \(rho = N[\(cso - rtbo\)\/\(cso + rtbo\)]\), 
                    ";", \(Rvo = Abs[rvo]\^2\), ";", \(Rho = Abs[rho]\^2\), 
                    ";", "\[IndentingNewLine]", \(Tv = 1 - Rv\), ";", 
                    " ", \(Th = 1 - Rh\), ";", 
                    "\[IndentingNewLine]", \(Tvs = 1 - Rvs\), ";", 
                    " ", \(Ths = 1 - Rhs\), ";", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                      RowBox[{
                        RowBox[{
                          RowBox[{
                            StyleBox["Rayleigh",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox[" ",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox["Phase",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox[" ",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox["functions",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox[" ",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox["and",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox[" ",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox["the",
                              FontColor->RGBColor[0, 0, 1]], " ", 
                            StyleBox["volume",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox[" ",
