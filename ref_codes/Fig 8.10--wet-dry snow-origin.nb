Cell["\<\
Step 4 (a). Compute backscattering from a Rayleigh layer with irregular \
boundaries----Fig 8.10 (a)\
\>", "Section",
  FontSize->18],

Cell[CellGroupData[{

Cell[BoxData[
    RowBox[{"\n", 
      RowBox[{
        RowBox[{
          RowBox[{
            StyleBox["fr",
              FontColor->RGBColor[0, 0, 1]], "=", "17"}], ";", 
          "  ", \(al = 0.96\), ";", \(tau = 0.3\), ";", " ", \(phs = 180\), 
          ";"}], "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            StyleBox["theta",
              FontColor->RGBColor[0, 0, 1]], "=", 
            StyleBox["thetas",
              FontColor->RGBColor[1, 0, 0]]}], ";", 
          RowBox[{
            StyleBox["er",
              FontColor->RGBColor[0, 0, 1]], "=", 
            StyleBox[\(1.6 - I\ 0.001\),
              FontColor->RGBColor[1, 0, 0]]}], ";", 
          RowBox[{
            StyleBox["erb",
              FontColor->RGBColor[0, 0, 1]], "=", "5"}], ";", 
          RowBox[{
            StyleBox["sig1",
              FontColor->RGBColor[0, 0, 1]], "=", 
            StyleBox[".1",
              FontColor->RGBColor[1, 0, 0]]}], ";", 
          RowBox[{
            StyleBox["sig2",
              FontColor->RGBColor[0, 0, 1]], "=", 
            StyleBox[
              RowBox[{"0", 
                StyleBox[".5",
                  FontColor->RGBColor[1, 0, 0]]}]]}], ";", " ", \(L1 = 1.2\), 
          ";", " ", \(L2 = 20.0\), ";", \(sp = 1\), ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
        RowBox[{
          RowBox[{"start", 
            StyleBox["=",
              FontColor->GrayLevel[0]], 
            StyleBox["10.010",
              FontColor->GrayLevel[0]]}], ";", 
          RowBox[{"end", 
            StyleBox["=",
              FontColor->GrayLevel[0]], 
            StyleBox[
              RowBox[{
                StyleBox["8",
                  FontColor->GrayLevel[0]], "0.01"}]]}], ";", \(step = 5\), 
          ";"}], "\n", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"outp", "=", 
            RowBox[{"Table", "[", 
              RowBox[{
                RowBox[{"Rlay", 
                  StyleBox["[",
                    FontColor->RGBColor[1, 0, 1]], \(fr, al, tau, theta, 
                  thetas, phs, er, erb/er, sig1, sig2, L1, L2, sp\), 
                  StyleBox["]",
                    FontSlant->"Italic",
                    FontColor->RGBColor[1, 0, 1]]}], ",", 
                RowBox[{"{", 
                  RowBox[{"thetas", 
                    StyleBox[",",
                      FontColor->GrayLevel[0]], 
                    StyleBox["start",
                      FontColor->GrayLevel[0]], 
                    StyleBox[",",
                      FontColor->GrayLevel[0]], 
                    StyleBox["end",
                      FontColor->GrayLevel[0]], 
                    StyleBox[",",
                      FontColor->GrayLevel[0]], 
                    StyleBox["step",
                      FontColor->GrayLevel[0]]}], "}"}]}], "]"}]}], ";"}], 
        "\n", \(vv = Map[{#[\([1]\)], #[\([2]\)]} &, outp];\), 
        "\n", \(hh = Map[{#[\([1]\)], #[\([3]\)]} &, outp];\), 
        "\[IndentingNewLine]", \(vov = 
            Map[{#[\([1]\)], #[\([4]\)]} &, outp];\), 
