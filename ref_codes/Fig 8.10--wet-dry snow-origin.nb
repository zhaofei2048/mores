Cell[BoxData[{
    RowBox[{
      RowBox[{
        StyleBox["fr",
          FontColor->RGBColor[0, 0, 1]], "=", "10"}], ";", 
      "  ", \(al = 0.42\), ";", \(tau = 0.75\), ";", " ", \(phs = 180\), 
      ";"}], "\n", 
    RowBox[{
      RowBox[{
        RowBox[{
          StyleBox["theta",
