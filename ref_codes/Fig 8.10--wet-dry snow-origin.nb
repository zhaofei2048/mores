                        FontSlant->"Italic"], "]"}]}], "]"}]}]}], ";", "\n", 
            RowBox[{"kh", "=", 
              RowBox[{"10", " ", 
                RowBox[{"Log", "[", 
                  RowBox[{"10", ",", 
                    RowBox[{"N", "[", 
                      StyleBox["aah",
                        FontSlant->"Italic"], "]"}]}], "]"}]}]}], ";", "\n", 
            RowBox[{
              StyleBox["qi",
                FontSlant->"Italic",
                FontColor->RGBColor[1, 0, 1]], 
              StyleBox["=",
                FontSlant->"Italic"], 
              StyleBox[\(k\ cs\),
                FontSlant->"Italic"]}], 
