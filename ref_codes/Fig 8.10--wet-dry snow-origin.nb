            FontColor->RGBColor[1, 0, 0]]}], ";", 
        RowBox[{
          StyleBox["erb",
            FontColor->RGBColor[0, 0, 1]], "=", \(2.65 - I\ 0.008\)}], ";", 
        " ", 
        RowBox[{
          StyleBox["sig1",
            FontColor->RGBColor[0, 0, 1]], "=", 
          StyleBox[".25",
            FontColor->RGBColor[1, 0, 0]]}], ";", 
        RowBox[{
          StyleBox["sig2",
            FontColor->RGBColor[0, 0, 1]], "=", 
          StyleBox[
            RowBox[{"0", 
              StyleBox[".39",
                FontColor->RGBColor[1, 0, 0]]}]]}], ";", " ", \(L1 = 5.79\), 
        ";", " ", \(L2 = 3.4\), ";", \(sp = 1\), ";"}], "\n"}], "\n", 
    RowBox[{
      RowBox[{
        RowBox[{"start", 
          StyleBox["=",
            FontColor->GrayLevel[0]], 
          StyleBox["10.01",
            FontColor->GrayLevel[0]]}], ";", 
        RowBox[{"end", 
          StyleBox["=",
            FontColor->GrayLevel[0]], 
          StyleBox[
            RowBox[{
              StyleBox["7",
                FontColor->GrayLevel[0]], "0.01"}]]}], ";", \(step = 5\), 
        ";"}], "\[IndentingNewLine]"}], "\n", 
    RowBox[{
      RowBox[{"outp", "=", 
        RowBox[{"Table", "[", 
          RowBox[{
            RowBox[{"Rlay", 
              StyleBox["[",
                FontColor->RGBColor[1, 0, 1]], \(fr, al, tau, theta, thetas, 
              phs, er, erb/er, sig1, sig2, L1, L2, sp\), 
              StyleBox["]",
                FontSlant->"Italic",
                FontColor->RGBColor[1, 0, 1]]}], ",", 
            RowBox[{"{", 
              RowBox[{"thetas", 
                StyleBox[",",
                  FontColor->GrayLevel[0]], 
                StyleBox["start",
                  FontColor->GrayLevel[0]], 
                StyleBox[",",
                  FontColor->GrayLevel[0]], 
                StyleBox["end",
                  FontColor->GrayLevel[0]], 
                StyleBox[",",
                  FontColor->GrayLevel[0]], 
                StyleBox["step",
                  FontColor->GrayLevel[0]]}], "}"}]}], "]"}]}], 
      ";"}], "\n", \(vv = 
        Map[{#[\([1]\)], #[\([2]\)]} &, outp];\), "\n", \(hh = 
        Map[{#[\([1]\)], #[\([3]\)]} &, 
          outp];\), "\[IndentingNewLine]", \(vov = 
        Map[{#[\([1]\)], #[\([4]\)]} &, outp];\), "\n", \(voh = 
        Map[{#[\([1]\)], #[\([5]\)]} &, 
          outp];\), "\[IndentingNewLine]", \(inv = 
        Map[{#[\([1]\)], #[\([6]\)]} &, outp];\), "\n", \(inh = 
        Map[{#[\([1]\)], #[\([7]\)]} &, 
          outp];\), "\[IndentingNewLine]", \(stv = 
        Map[{#[\([1]\)], #[\([8]\)]} &, outp];\), "\n", \(sth = 
        Map[{#[\([1]\)], #[\([9]\)]} &, outp];\), "\n", \(sbv = 
        Map[{#[\([1]\)], #[\([10]\)]} &, outp];\), "\n", \(sbh = 
        Map[{#[\([1]\)], #[\([11]\)]} &, 
          outp];\), "\[IndentingNewLine]", \(cov = 
        Map[{#[\([1]\)], #[\([12]\)]} &, outp];\), "\n", 
    RowBox[{\(coh = Map[{#[\([1]\)], #[\([13]\)]} &, outp];\), 
      "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
    RowBox[{\(Needs["\<Statistics`DataManipulation`\>"];\), "\n", 
      "\n"}], "\n", \(Print[
        TableForm[{vv}, 
          TableHeadings \[Rule] {{\*"\"\<VV \!\(\[Sigma]\^0\)\>\""}, \
{"\<Layer\>"}}]];\), "\n", \(Print[
        TableForm[{hh}, 
          TableHeadings \[Rule] {{\*"\"\<HH \!\(\[Sigma]\^0\)\>\""}, \
{"\<Layer\>"}}]];\), "\[IndentingNewLine]", "Null"}], "Input",
  FontSize->18],

