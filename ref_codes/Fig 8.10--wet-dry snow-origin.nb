Cell[CellGroupData[{

Cell["\<\
Step 4 (b). Compute backscattering from a Rayleigh layer with irregular \
boundaries----Fig 8.10 (b) using wet snow --data from p.877-----vol.2\
\>", "Section",
  FontSize->18],

Cell[CellGroupData[{

Cell[BoxData[
    RowBox[{"\n", 
      RowBox[{
        RowBox[{
          RowBox[{
            StyleBox["fr",
              FontColor->RGBColor[0, 0, 1]], "=", "17"}], ";", 
          "  ", \(al = 0.17\), ";", \(tau = 2.5\), ";", " ", \(phs = 180\), 
          ";"}], "\n", 
        RowBox[{
          RowBox[{
            StyleBox["theta",
              FontColor->RGBColor[0, 0, 1]], "=", 
            StyleBox["thetas",
              FontColor->RGBColor[1, 0, 0]]}], ";", 
          RowBox[{
            StyleBox["er",
              FontColor->RGBColor[0, 0, 1]], "=", 
            StyleBox[\(1.7 - I\ 0.005\),
              FontColor->RGBColor[1, 0, 0]]}], ";", 
          RowBox[{
            StyleBox["erb",
              FontColor->RGBColor[0, 0, 1]], "=", "5"}], ";", 
          RowBox[{
            StyleBox["sig1",
              FontColor->RGBColor[0, 0, 1]], "=", 
            StyleBox[".1",
              FontColor->RGBColor[1, 0, 0]]}], ";", 
          RowBox[{
            StyleBox["sig2",
              FontColor->RGBColor[0, 0, 1]], "=", 
            StyleBox[
              RowBox[{"0", 
                StyleBox[".5",
                  FontColor->RGBColor[1, 0, 0]]}]]}], ";", " ", \(L1 = 1.2\), 
          ";", " ", \(L2 = 20.0\), ";", \(sp = 1\), ";"}], "\n", "\n", 
        RowBox[{
          RowBox[{"start", 
            StyleBox["=",
              FontColor->GrayLevel[0]], 
            StyleBox["10.010",
              FontColor->GrayLevel[0]]}], ";", 
          RowBox[{"end", 
            StyleBox["=",
              FontColor->GrayLevel[0]], 
            StyleBox[
              RowBox[{
                StyleBox["7",
                  FontColor->GrayLevel[0]], "0.01"}]]}], ";", \(step = 5\), 
          ";"}], "\[IndentingNewLine]", "\n", 
        RowBox[{
          RowBox[{"outp", "=", 
            RowBox[{"Table", "[", 
              RowBox[{
                RowBox[{"Rlay", 
                  StyleBox["[",
                    FontColor->RGBColor[1, 0, 1]], \(fr, al, tau, theta, 
                  thetas, phs, er, erb/er, sig1, sig2, L1, L2, sp\), 
                  StyleBox["]",
                    FontSlant->"Italic",
                    FontColor->RGBColor[1, 0, 1]]}], ",", 
                RowBox[{"{", 
                  RowBox[{"thetas", 
                    StyleBox[",",
                      FontColor->GrayLevel[0]], 
                    StyleBox["start",
                      FontColor->GrayLevel[0]], 
                    StyleBox[",",
                      FontColor->GrayLevel[0]], 
                    StyleBox["end",
                      FontColor->GrayLevel[0]], 
                    StyleBox[",",
                      FontColor->GrayLevel[0]], 
                    StyleBox["step",
                      FontColor->GrayLevel[0]]}], "}"}]}], "]"}]}], ";"}], 
        "\n", \(vv = Map[{#[\([1]\)], #[\([2]\)]} &, outp];\), 
        "\n", \(hh = Map[{#[\([1]\)], #[\([3]\)]} &, outp];\), 
        "\[IndentingNewLine]", \(vov = 
            Map[{#[\([1]\)], #[\([4]\)]} &, outp];\), 
        "\n", \(voh = Map[{#[\([1]\)], #[\([5]\)]} &, outp];\), 
        "\[IndentingNewLine]", \(inv = 
            Map[{#[\([1]\)], #[\([6]\)]} &, outp];\), 
        "\n", \(inh = Map[{#[\([1]\)], #[\([7]\)]} &, outp];\), 
        "\[IndentingNewLine]", \(stv = 
            Map[{#[\([1]\)], #[\([8]\)]} &, outp];\), 
        "\n", \(sth = Map[{#[\([1]\)], #[\([9]\)]} &, outp];\), 
        "\n", \(sbv = Map[{#[\([1]\)], #[\([10]\)]} &, outp];\), 
        "\n", \(sbh = Map[{#[\([1]\)], #[\([11]\)]} &, outp];\), 
        "\[IndentingNewLine]", 
        "\[IndentingNewLine]", \(Needs["\<Statistics`DataManipulation`\>"];\),
         "\n", \(Needs["\<Graphics`MultipleListPlot`\>"];\), "\n", 
        "\n", \(Print[
            TableForm[{vv, vov, inv, stv, sbv}, 
              TableHeadings \[Rule] {{\*"\"\<VV \!\(\[Sigma]\^0\)\>\""}, \
{"\<Layer\>"}}]];\), 
        "\n", \(Print[
            TableForm[{hh, voh, inh, sth, sbh}, 
              TableHeadings \[Rule] {{\*"\"\<HH \!\(\[Sigma]\^0\)\>\""}, \
{"\<Layer\>"}}]];\), "\[IndentingNewLine]"}]}]], "Input",
  FontSize->18],

