                      w[n]\/\(n!\)\)}]}]}],
              FontSlant->"Italic"], 
            StyleBox[";",
              FontSlant->"Italic"], "\n", 
            RowBox[{"ssv", "=", 
              RowBox[{"10", " ", 
                RowBox[{"Log", "[", 
                  RowBox[{"10", ",", 
                    RowBox[{"N", "[", 
                      StyleBox["iemmvv",
                        FontSlant->"Italic"], "]"}]}], "]"}]}]}], ";", "\n", 
            RowBox[{"ssh", "=", 
              RowBox[{"10", " ", 
                RowBox[{"Log", "[", 
                  RowBox[{"10", ",", 
                    RowBox[{"N", "[", 
                      StyleBox[
                        RowBox[{"iemm", 
                          StyleBox["hh",
                            FontSlant->"Italic"]}]], "]"}]}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", \( (*Compute\ the\ old\ IEM*) \), 
            "\[IndentingNewLine]", \(sq = \@\(\[Mu]r\ er - s\^2\)\), 
            ";", \(sqs = \@\(\[Mu]r\ er - ss\^2\)\), 
            ";", \(rcs = \(css\ sq\)\/\(cs\ sqs\)\), ";", 
            "\[IndentingNewLine]", \(Fvv = \((\((\[Mu]r\ er - s\^2 - 
                          er\ cs\^2)\) \((1 + Rvi)\)\^2)\)/\((\(\((er\ \
cs)\)\^2\) css)\) s \((ss - s\ cfs)\)\), 
            ";", \(Fhh = \(-\(\((\((\[Mu]r\ er - 
                            s\^2 - \[Mu]r\ cs\^2)\) \((1 + Rhi)\)\^2)\)/\((\(\
\((\[Mu]r\ cs)\)\^2\) css)\)\)\) s \((ss - s\ cfs)\)\), ";", 
            "\[IndentingNewLine]", \(Fvs = \((1 - 
                    Rvi\^2)\) \((\((1\/rcs - 1)\) 
                      css\ cfs\  + \(1\/cs\) \((\((1 - rcs)\) \((cfs - 
                              s\ ss)\))\) + \(1\/sq\) \((\((er - 
                              rcs)\)\ ss \((s - ss\ cfs)\))\))\)\), ";", 
            "\[IndentingNewLine]", \(Fhs = \(-\((1 - 
                      Rhi\^2)\)\) \((\((1\/rcs - 1)\) 
                      css\ cfs\  + \(1\/cs\) \((\((1 - rcs)\) \((cfs - 
                              s\ ss)\))\) + \(1\/sq\) \((\((\[Mu]r - 
                              rcs)\)\ ss \((s - ss\ cfs)\))\))\)\), ";", 
            "\[IndentingNewLine]", \(oIvv = \(\((kz + ksz)\)\^n\) 
                  fvv\ Exp[\(-\[Sigma]\^2\) 
                      kz\ ksz] + \(\(ksz\^n\) Fvv + \(kz\^n\) Fvs\)\/2\), ";",
             "\[IndentingNewLine]", \(oIhh = \(\((kz + ksz)\)\^n\) 
                  fhh\ Exp[\(-\[Sigma]\^2\) 
                      kz\ ksz] + \(\(ksz\^n\) Fhh + \(kz\^n\) Fhs\)\/2\), ";",
             "\[IndentingNewLine]", 
            RowBox[{"iemvv", "=", 
              StyleBox[
                RowBox[{
                "ShdwS", \(k\^2\/2\), \(Exp[\(-\[Sigma]\^2\) \((kz\^2 + 
                          ksz\^2)\)]\), 
                  RowBox[{
                    UnderoverscriptBox["\[Sum]", 
                      RowBox[{"n", "=", 
                        StyleBox["1",
                          FontSlant->"Italic"]}], "TS"], 
                    RowBox[{\(\[Sigma]\^\(2  n\)\), 
                      SuperscriptBox[
                        RowBox[{"Abs", "[", 
                          StyleBox["oIvv",
                            FontSlant->"Italic"], 
                          StyleBox["]",
                            FontSlant->"Italic"]}], "2"], 
                      " ", \(w[n]\/\(n!\)\)}]}]}],
                FontSlant->"Italic"]}], 
            StyleBox[";",
              FontSlant->"Italic"], 
            StyleBox["\[IndentingNewLine]",
              FontSlant->"Italic"], 
            RowBox[{"iemhh", "=", 
              StyleBox[
                RowBox[{
                "ShdwS", \(k\^2\/2\), \(Exp[\(-\[Sigma]\^2\) \((kz\^2 + 
                          ksz\^2)\)]\), 
                  RowBox[{
                    UnderoverscriptBox["\[Sum]", 
                      RowBox[{"n", "=", 
                        StyleBox["1",
                          FontSlant->"Italic"]}], "TS"], 
                    RowBox[{\(\[Sigma]\^\(2  n\)\), 
                      SuperscriptBox[
                        RowBox[{"Abs", "[", 
                          StyleBox["oIhh",
                            FontSlant->"Italic"], 
                          StyleBox["]",
                            FontSlant->"Italic"]}], "2"], 
                      " ", \(w[n]\/\(n!\)\)}]}]}],
                FontSlant->"Italic"]}], 
            StyleBox[";",
              FontSlant->"Italic"], 
            StyleBox["\[IndentingNewLine]",
              FontSlant->"Italic"], 
            StyleBox["\[IndentingNewLine]",
              FontSlant->"Italic"], 
            RowBox[{"sov", "=", 
              RowBox[{"10", " ", 
                RowBox[{"Log", "[", 
                  RowBox[{"10", ",", 
                    RowBox[{"N", "[", 
                      StyleBox["iemvv",
                        FontSlant->"Italic"], "]"}]}], "]"}]}]}], ";", "\n", 
            RowBox[{"soh", "=", 
              RowBox[{"10", " ", 
                RowBox[{"Log", "[", 
                  RowBox[{"10", ",", 
                    RowBox[{"N", "[", 
                      StyleBox[
                        RowBox[{"iem", 
                          StyleBox["hh",
                            FontSlant->"Italic"]}]], "]"}]}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            "\n", \(Return[{ths, iemmvv, iemmhh, sov, soh}]\), ";"}]}], 
        "]"}]}], "\n", \(End[]; EndPackage[]\)}], "Input",
  CellMargins->{{30.3125, Inherited}, {Inherited, Inherited}},
  FontSize->18],

