Notebook[{

Cell[CellGroupData[{
Cell["Step 1. Load the bistatic scattering program- IEMM", "Section",
  Evaluatable->False,
  TextAlignment->Left,
  TextJustification->0,
  AspectRatioFixed->True,
  FontSize->18,
  FontColor->RGBColor[1, 0, 1]],

Cell[BoxData[{\(Off[
      General::"\<spell1\>"]; \((\(Off[
          General::"\<spell\>"];\))\)\), "\n", \
\(BeginPackage["\<IEMM`\>"];\), "\n", \(IEMM::"\<usage\>" = "\<Calculates \
Bistatic Single surface scattering\>";\), "\n", \(Begin["\<`private`\>"];\), \
"\n", 
    RowBox[{
      RowBox[{"IEMM", 
        StyleBox["[",
          FontColor->RGBColor[1, 0, 1]], \(fr_, sig_, corr_, theta_, ths_, 
        phs_, er_, sp_, xx_\), 
        StyleBox["]",
          FontSlant->"Italic",
          FontColor->RGBColor[1, 0, 1]]}], ":=", 
      RowBox[{"Module", "[", 
        RowBox[{\({}\), ",", "\n", 
          
          RowBox[{\(k = \(2.0\ \[Pi]\ fr\)\/30.0\), ";", \(phi = 0.0\), 
            ";", \(\[Sigma] = sig\), ";", \(L = corr\), ";", \(\[Mu]r = 1\), 
            ";", \(thetas = ths\), ";", "\n", \(ks = k\ sig\), 
            ";", \(kL = k*corr\), ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", \(s = N[Sin[\((theta + 0.01)\)\ Degree]]\),
             ";", "\n", \(cs = N[Cos[\((theta + 0.01)\)\ Degree]]\), ";", 
            "\n", \(sf = N[Sin[phi\ Degree]]\), ";", 
            "\n", \(cf = N[Cos[phi\ Degree]]\), ";", "\n", 
            "\n", \(ss = N[Sin[ths\ Degree]]\), ";", \(s2 = s*s\), ";", 
            "\[IndentingNewLine]", \(css = N[Cos[ths\ Degree]]\), ";", 
            "\[IndentingNewLine]", \(cfs = N[Cos[phs\ Degree]]\), ";", 
            "\n", \(sfs = N[Sin[phs\ Degree]]\), ";", "\n", "\n", 
            "  ", \(kx = N[k\ s\ cf]\), ";", "       ", \(ky = N[k\ s\ sf]\), 
            ";", "      ", \(kz = N[k\ cs]\), ";", 
            "\n", \(ksx = N[k\ ss\ cfs]\), ";", \(ksy = N[k\ ss\ sfs]\), 
            ";", \(ksz = N[k\ css]\), ";", "\n", 
            "\n", \(rt = \@\(er - s\^2\)\), 
            ";", \(Rvi = N[\(er\ cs - rt\)\/\(er\ cs + rt\)]\), 
            ";", \(Rhi = N[\(cs - rt\)\/\(cs + rt\)]\), ";", 
            "\[IndentingNewLine]", "\n", 
            "\n", \(wvnb = 
              k\ \[Sqrt]\((\((ss\ cfs - s\ cf)\)\^2 + \((ss\ sfs - \ s\ sf)\)\
\^2)\)\), ";", "\n", \(TS = 1\), ";", \(error = 10\^8\), 
            ";", \(While[error > 1\/10\^8, TS = TS + 1; 
              error = \((ks\^2\ \((cs + css)\)\^2)\)\^TS\/\(TS!\);]\), ";", 
            "\n", 
            RowBox[{"spctrm", "=", 
              RowBox[{"Switch", "[", 
                RowBox[{"sp", ",", "\n", "\t\t\t           ", "1", ",", 
                  RowBox[{"Do", "[", " ", 
                    RowBox[{
                      RowBox[{\(w[n]\), "=", 
                        RowBox[{"N", "[", 
                          
                          StyleBox[\(L\^2\/n\^2\ \((1 + \((\(wvnb\ \
L\)\/n)\)\^2)\)\^\(-1.5\)\),
                            FontColor->RGBColor[0, 0, 1]], 
                          StyleBox["]",
                            FontColor->RGBColor[0, 0, 1]]}]}], 
                      ",", \({n, 1, TS, 1}\)}], "]"}], 
                  StyleBox[",",
                    FontColor->RGBColor[0, 0, 1]], "\n", "\t\t\t\t", "2", ",",
                   
                  RowBox[{"Do", "[", " ", 
                    RowBox[{
                      RowBox[{\(w[n]\), "=", 
                        RowBox[{"N", "[", 
                          
                          StyleBox[\(L\^2\/\(2\ n\)\ Exp[\(-\(\((wvnb\ \
L)\)\^2\/\(4\ n\)\)\)]\),
                            FontColor->RGBColor[0, 0, 1]], 
                          StyleBox["]",
                            FontColor->RGBColor[0, 0, 1]]}]}], 
                      ",", \({n, 1, TS, 1}\)}], "]"}], 
                  StyleBox[",",
                    FontColor->RGBColor[0, 0, 1]], "\[IndentingNewLine]", "3",
                   ",", 
                  RowBox[{"Do", "[", " ", 
                    RowBox[{
                      RowBox[{\(w[n]\), "=", 
                        
                        StyleBox[\(If[wvnb == 0, L\^2\/\(3\ n - 2\), 
                            N[\((L\^2\ \((wvnb\ L)\)\^\(xx\ n - 1\)\ BesselK[\
\(-xx\)\ n + 1, wvnb\ L])\)/\((2\^\(xx\ n - 1\)\ Gamma[xx\ n])\)]]\),
                          FontColor->RGBColor[0, 0, 1]]}], 
                      StyleBox[",",
                        FontColor->RGBColor[0, 0, 1]], \({n, 1, TS, 1}\)}], 
                    "]"}], 
                  StyleBox[",",
                    FontColor->RGBColor[0, 0, 1]], "\t", 
                  "\[IndentingNewLine]", "4", ",", 
                  RowBox[{"Do", "[", " ", 
                    RowBox[{
                      RowBox[{\(w[n]\), "=", "  ", 
                        RowBox[{
                          StyleBox[\(L\^2\/n\^\(2/xx\)\),
                            FontSlant->"Italic",
                            FontColor->RGBColor[0, 0, 1]], 
                          StyleBox["*",
                            FontSlant->"Italic",
                            FontColor->RGBColor[0, 0, 1]], 
                          RowBox[{
                            StyleBox["NIntegrate",
                              FontSlant->"Italic",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox["[",
                              FontSlant->"Italic",
                              FontColor->RGBColor[1, 0, 0]], 
                            RowBox[{
                              RowBox[{
                                StyleBox[
                                  RowBox[{"Exp", "[", 
                                    RowBox[{"-", 
                                      SuperscriptBox[
                                        RowBox[{
                                        StyleBox["(",
                                        FontColor->RGBColor[0, 0, 1]], 
                                        StyleBox[\(Abs[z]\),
                                        FontColor->RGBColor[1, 0, 0]], 
                                        StyleBox[")",
                                        FontColor->RGBColor[0, 0, 1]]}], 
                                        "xx"]}], "]"}],
                                  FontSlant->"Italic",
                                  FontColor->RGBColor[0, 0, 1]], 
                                StyleBox["*",
                                  FontSlant->"Italic",
                                  FontColor->RGBColor[0, 0, 1]], 
                                RowBox[{
                                  StyleBox["BesselJ",
                                    FontSlant->"Italic",
                                    FontColor->RGBColor[0, 0, 1]], 
                                  StyleBox["[",
                                    FontSlant->"Italic",
                                    FontColor->RGBColor[0, 0, 1]], 
                                  RowBox[{
                                    StyleBox["0",
                                      FontSlant->"Italic",
                                      FontColor->RGBColor[0, 0, 1]], 
                                    StyleBox[",",
                                      FontSlant->"Italic",
                                      FontColor->RGBColor[0, 0, 1]], 
                                    RowBox[{
                                      StyleBox["z",
                                        FontSlant->"Italic",
                                        FontColor->RGBColor[0, 0, 1]], 
                                      StyleBox["*",
                                        FontSlant->"Italic",
                                        FontColor->RGBColor[0, 0, 1]], 
                                      StyleBox["wvnb",
                                        FontSlant->"Italic"], 
                                      StyleBox[" ",
                                        FontSlant->"Italic"], 
                                      StyleBox["L",
                                        FontSlant->"Italic"], 
                                      StyleBox["*",
                                        FontSlant->"Italic",
                                        FontColor->RGBColor[0, 0, 1]], 
                                      RowBox[{
                                        StyleBox["(",
                                        FontSlant->"Italic",
                                        FontColor->RGBColor[0, 0, 1]], 
                                        StyleBox[
                                        RowBox[{
                                        StyleBox["1",
                                        FontColor->RGBColor[0, 0, 1]], 
                                        StyleBox["/",
                                        FontColor->RGBColor[0, 0, 
                                        1]], \(n\^\(1/xx\)\)}],
                                        FontSlant->"Italic"], 
                                        StyleBox[")",
                                        FontSlant->"Italic"]}]}]}], 
                                  StyleBox["]",
                                    FontSlant->"Italic",
                                    FontColor->RGBColor[0, 0, 1]]}], 
                                StyleBox["*",
                                  FontSlant->"Italic",
                                  FontColor->RGBColor[0, 0, 1]], 
                                StyleBox["z",
                                  FontSlant->"Italic",
                                  FontColor->RGBColor[0, 0, 1]]}], 
                              StyleBox[",",
                                FontSlant->"Italic",
                                FontColor->RGBColor[0, 0, 1]], 
                              StyleBox[\({z, 0, 9}\),
                                FontSlant->"Italic",
                                FontColor->RGBColor[0, 0, 1]]}], 
                            StyleBox["]",
                              FontSlant->"Italic",
                              FontColor->RGBColor[0, 0, 1]]}]}]}], 
                      StyleBox[",",
                        FontColor->RGBColor[0, 0, 1]], \({n, 1, TS, 1}\)}], 
                    "]"}], 
                  StyleBox[",",
                    FontColor->RGBColor[0, 0, 1]], 
                  StyleBox["\[IndentingNewLine]",
                    FontColor->RGBColor[0, 0, 1]], 
                  StyleBox["5",
                    FontColor->RGBColor[0, 0, 1]], 
                  StyleBox[",",
                    FontColor->RGBColor[0, 0, 1]], 
                  RowBox[{"Do", "[", " ", 
                    RowBox[{
                      RowBox[{\(w[n]\), "=", 
                        RowBox[{"N", "[", 
                          StyleBox[
                            RowBox[{\(\[Sum]\+\(m = 0\)\%\(TS + 5\)\), 
                              
                              RowBox[{\(L\^2\), \(n\^m\/\(m!\)\), 
                                " ", \(\((\(\(xx\)\(\ \)\)\/\(n\ xx + m\ L\))\
\)\^\(m + 2\)\), "  ", \(Gamma[2 + m]\), " ", 
                                RowBox[{"Hypergeometric2F1", "[", 
                                  
                                  RowBox[{\(\(2 + m\)\/2\), 
                                    ",", \(\(3 + m\)\/2\), ",", "1", ",", 
                                    RowBox[{"-", 
                                      SuperscriptBox[
                                        RowBox[{"(", 
                                        
                                        StyleBox[\(\(\(xx\)\(\ \ \)\(wvnb\)\(\
\ \)\(L\)\(\ \)\)\/\(n\ xx + m\ L\)\),
                                        FontColor->RGBColor[0, 0, 1]], ")"}], 
                                        "2"]}]}], "]"}]}]}],
                            FontColor->RGBColor[0, 0, 1]], 
                          StyleBox["]",
                            FontColor->RGBColor[0, 0, 1]]}]}], 
                      StyleBox[",",
                        FontColor->RGBColor[0, 0, 1]], \({n, 1, TS, 1}\)}], 
                    "]"}]}], 
                StyleBox["   ",
                  FontColor->RGBColor[0, 0, 1]], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            "\[IndentingNewLine]", \( (*Compute\ R - transition*) \), 
            "\[IndentingNewLine]", 
            StyleBox[\(Rv0 = N[\(er\  - \@er\)\/\(er\  + \@er\)]\),
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox[";",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox[\(Rh0 = \(-Rv0\)\),
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox[";",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\t",
              FontColor->RGBColor[1, 0, 0]], 
            
            StyleBox[\(Ft = 
                8\ \ \(Rv0\^2\) s*
                  s \((\ \(cs + \@\(er - s\^2\)\)\/\(cs\ \@\(er - s\^2\)\))\)\
\),
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox[";",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\n",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\t",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], 
            
            StyleBox[\(St = \((0.25*
                      Abs[Ft]\^2\ \(\[Sum]\+\(n = 1\)\%TS\(\(\(\((ks\ cs)\)\^\
\(2\ n\)\)\(\ \ \)\)\/\(n!\)\) 
                          w[n]\))\)/\((\[Sum]\+\(n = 1\)\%TS\(\(\(\((ks\ \
cs)\)\^\(2\ n\)\)\(\ \ \)\)\/\(n!\)\) \(Abs[
                              Ft\/2 + \(2\^\(n + 1\)\) \(Rv0\/cs\) 
                                  Exp[\(-\((ks\ cs)\)\^2\)]]\^2\) w[n])\)\),
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox[";",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\n",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], 
            
            StyleBox[\( (*there\ is\ really\ no\ difference\ between\ Stv\ \
and\ \(Sth\ !\)\ \ St0 = \ \(Stv\ when\ n = 
                    1\ and\ ks \[Rule] \ 0. \ We\ drop\ v\ or\ h\)\ *) \),
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], 
            
            StyleBox[\( (*S0 = \(\((0.25\ ks\ cs\ \(Abs[Fvv]\^2\) 
                          w[n])\)/\((ks\ cs\ \(Abs[
                                Fvv\/2 + \(2\^\(n + 1\)\) \(Rv0\/cs\) 
                                    Exp[\(-\((ks\ cs)\)\^2\)]]\^2\) 
                          w[n])\) = \(\(0.25\ Abs[Fvv]\^2\)\/Abs[Fvv\/2 + 4  \
Rv0\/cs]\^2 = \(\(\(\ \)\(Abs[Fvv]\^2\)\)\/Abs[Fvv + 8  Rv0\/cs]\^2\) 
                        has\ no\ polarization\ dependence\)\)*) \),
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\n",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox[\(St0 = 1\/Abs[1 + 8  Rv0\/\(cs\ *Ft\)]\^2\),
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox[";",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox[\(Tf = 1 - St/St0\),
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox[";",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox[\(Rtv = Rvi\  + \((Rv0 - Rvi)\) Tf\),
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox[";",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox[\(Rth = Rhi\  + \((Rh0 - Rhi)\) Tf\),
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox[";",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], 
            RowBox[{
              StyleBox["(*",
                FontColor->RGBColor[1, 0, 0]], 
              RowBox[{
                StyleBox["Rtv",
                  FontColor->RGBColor[0, 0, 1]], 
                StyleBox[",",
                  FontColor->RGBColor[0, 0, 1]], 
                StyleBox[" ",
                  FontColor->RGBColor[0, 0, 1]], 
                RowBox[{
                  RowBox[{
                    RowBox[{
                      StyleBox["Rth",
                        FontColor->RGBColor[0, 0, 1]], 
                      StyleBox[" ",
                        FontColor->RGBColor[0, 0, 1]], 
                      StyleBox["are",
                        FontColor->RGBColor[0, 0, 1]], 
                      StyleBox[" ",
                        FontColor->RGBColor[0, 0, 1]], 
                      StyleBox["needed",
                        FontColor->RGBColor[0, 0, 1]], 
                      StyleBox[" ",
                        FontColor->RGBColor[0, 0, 1]], 
                      StyleBox["for",
                        FontColor->RGBColor[0, 0, 1]], 
                      StyleBox[" ",
                        FontColor->RGBColor[0, 0, 1]], 
                      StyleBox["frequency",
                        FontColor->RGBColor[0, 0, 1]], 
                      StyleBox[" ",
                        FontColor->RGBColor[0, 0, 1]], 
                      StyleBox["behavior",
                        FontColor->RGBColor[0, 0, 1]], 
                      StyleBox[" ",
                        FontColor->RGBColor[0, 0, 1]], 
                      StyleBox["calculation",
                        FontColor->RGBColor[0, 0, 1]], "\n", "\t\t", "\n", 
                      "\t", "A"}], "=", \((cs + Zx*s)\)}], ";", "\n", 
                  "\t", \(B = er*\((1 + Zx\^\(\(2\)\(\ \ \)\) + Zy\^2)\)\), 
                  ";", "\n", 
                  "\t", \(CC = 
                    s\^2 - 2*Zx*s*cs + Zx\^\(\(2\)\(\ \ \)\)*cs\^2 + Zy\^2\), 
                  ";", "\n", "\t", "\n", 
                  "\t", \(Rh = \(A - \@\(B - CC\)\)\/\(A + \@\(B - CC\)\)\), 
                  ";", " ", \(Rv = \(er*A - \@\(B - CC\)\)\/\(er*A + \@\(B - \
CC\)\)\), ";", "\n", "\t", "\n", \(\[Sigma]x = 1.1*sig/L\), 
                  ";", \(\[Sigma]y = \[Sigma]x\), ";", "\n", 
                  "\t", \(pd = 
                    Exp[\(-\(Zx\^2\/\(2*\[Sigma]x\^2\)\)\) - 
                        Zy\^2\/\(2*\[Sigma]y\^2\)]\), ";", "\n", 
                  "\t", \(Ra = 
                    1\/\(2*\[Pi]*\[Sigma]x*\[Sigma]y\)*
                      NIntegrate[{Rv*pd, Rh*pd}, {Zx, \(-3\)*\[Sigma]x, 0, 
                          3*\[Sigma]x}, {Zy, \(-3\)*\[Sigma]y, 0, 
                          3*\[Sigma]y}]\), ";", "\n", "\t\t\t", "\n", "\t\t", 
                  "\n", 
                  StyleBox[" ",
                    FontColor->RGBColor[1, 0, 
                    0]], \(fvv = \((\((2\ \ Ra[\([1]\)])\)\ \((s\ ss - \((1 + 
                                    cs\ css)\)\ cfs)\))\)/\((cs + css)\)\), 
                  ";", \(fhh = \(-\(\((\((2\ Ra[\([2]\)])\)\ \((s\ ss - \((1 \
+ cs\ css)\)\ cfs)\))\)/\((cs + css)\)\)\)\), ";"}]}], 
              StyleBox["*)",
                FontColor->RGBColor[1, 0, 0]]}], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], "\t", 
            RowBox[{
              StyleBox["(*",
                FontColor->RGBColor[1, 0, 0]], 
              StyleBox[" ",
                FontColor->RGBColor[1, 0, 0]], 
              
              StyleBox[\(Average\ reflection\ coefficients, \ 
                Ra[\([1]\)]\ and\ Ra[\([2]\)], \ 
                are\ to\ correct\ scattering\ near\ the\ Brewster\ angle\),
                FontColor->RGBColor[0, 0, 1]], 
              StyleBox["*)",
                FontColor->RGBColor[1, 0, 0]]}], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], 
            StyleBox["\[IndentingNewLine]",
              FontColor->RGBColor[1, 0, 0]], 
            RowBox[{"fvv", "=", 
              RowBox[{"N", "[", 
                RowBox[{\(1\/\(cs + css\)\), 
                  RowBox[{"(", " ", 
                    RowBox[{
                      StyleBox[\((2\ Rtv)\),
                        FontColor->RGBColor[1, 0, 1]], 
                      " ", \((s\ ss - \((cs\ css + 1)\)\ cfs)\)}], ")"}]}], 
                "]"}]}], ";", " ", "\n", 
            RowBox[{"fhh", "=", 
              RowBox[{"N", "[", 
                RowBox[{\(-\(1\/\(cs + css\)\)\), 
                  RowBox[{"(", 
                    RowBox[{
                      StyleBox[\((2\ Rth)\),
                        FontColor->RGBColor[1, 0, 1]], 
                      " ", \((s\ ss - \((cs\ css + 1)\)\ cfs)\)}], ")"}]}], 
                "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            "\n", "\[IndentingNewLine]", 
            RowBox[{"(*", 
              
              StyleBox[\(There\ are\ 4\ F - \(coefficients : 
                    up - down\ \((ud)\) and\ incident - scatter\ \((is)\)\)\),
                
                FontColor->RGBColor[0, 0, 1]], " ", "*)"}], 
            "\[IndentingNewLine]", "\t\t ", 
            RowBox[{
              StyleBox[\(F[ud_, is_]\),
                FontSlant->"Italic",
                FontColor->RGBColor[1, 0, 0]], 
              StyleBox[":=",
                FontSlant->"Italic"], 
              RowBox[{
                StyleBox["Module",
                  FontSlant->"Italic"], 
                StyleBox["[",
                  FontSlant->"Italic"], 
                RowBox[{
                  RowBox[{
                    StyleBox["{",
                      FontSlant->"Italic"], 
                    
                    StyleBox[\(vv, hh, c11, c21, c31, c41, c51, c61, c12, 
                      c22, c32, c42, c52, c62, q, qt\),
                      FontSlant->"Italic"], "}"}], 
                  StyleBox[",",
                    FontSlant->"Italic"], "\n", 
                  StyleBox["\t\t\t\t",
                    FontSlant->"Italic"], 
                  RowBox[{
                    RowBox[{
                      StyleBox["If",
                        FontSlant->"Italic"], 
                      StyleBox["[",
                        FontSlant->"Italic"], 
                      RowBox[{
                        StyleBox[\(is == 1\),
                          FontSlant->"Italic"], 
                        StyleBox[",",
                          FontSlant->"Italic"], 
                        RowBox[{
                          StyleBox["{",
                            FontSlant->"Italic"], 
                          StyleBox["\n",
                            FontSlant->"Italic"], 
                          RowBox[{
                            RowBox[{
                              StyleBox["Gqi",
                                FontSlant->"Italic",
                                FontColor->RGBColor[1, 0, 1]], 
                              StyleBox["=",
                                FontSlant->"Italic",
                                FontColor->RGBColor[1, 0, 1]], 
                              RowBox[{
                                StyleBox["ud",
                                  FontSlant->"Italic",
                                  FontColor->RGBColor[1, 0, 0]], 
                                StyleBox[" ",
                                  FontSlant->"Italic"], 
                                StyleBox["kz",
                                  FontSlant->"Italic"]}]}], 
                            StyleBox[";",
                              FontSlant->"Italic"], 
                            StyleBox[" ",
                              FontSlant->"Italic"], 
                            RowBox[{
                              StyleBox["(*",
                                FontSlant->"Italic"], 
                              StyleBox[" ",
                                FontSlant->"Italic",
                                FontColor->RGBColor[0, 0, 1]], 
                              
                              StyleBox[\(Gqi\ will\ switch\ to\ Gqti, \ 
                                when\ Ci1\ changes\ to\ Ci2 . \ 
                                    This\ applies\ to\ C2i, \ C3i, \ C5i\),
                                FontSlant->"Italic",
                                FontColor->RGBColor[0, 0, 1]], 
                              StyleBox["*)",
                                FontSlant->"Italic"]}], 
                            StyleBox[
                              RowBox[{
                                StyleBox[" ",
                                  FontSlant->"Italic"], 
                                StyleBox[" ",
                                  FontSlant->"Italic",
                                  FontColor->RGBColor[1, 0, 1]]}]], 
                            RowBox[{
                              StyleBox["Gqti",
                                FontSlant->"Italic",
                                FontColor->RGBColor[1, 0, 1]], 
                              StyleBox["=",
                                FontSlant->"Italic"], 
                              RowBox[{
