                          StyleBox[\(0\ means\ the\ TR\ are\ together\ and\ \
phs = 180\ means\ TR\ are\ 180\ apart\),
                            FontColor->RGBColor[1, 0, 0]]}], 
                        StyleBox[",",
                          FontColor->RGBColor[1, 0, 0]], 
                        StyleBox[" ",
