            "\[IndentingNewLine]", 
            StyleBox["\n",
              FontSlant->"Italic"], \( (*ct = N[Cot[theta\ Degree]]; \n
              cts = N[Cot[thetas\ Degree]]; \n
              rslp = Switch[
                  sp, \n\t\t\t\t\t\t1, \(\@1\) 
                    sig\/L, \n\t\t\t\t\t\t2, \(\@2\) sig\/L, \n\t\t\t\t\t\t3, 
                  If[xx == 1.5, \(\@3\) sig\/L, 0], \n\t\t\t\t\t\t4, \(\@1\) 
                    sig\/L, \n\t\t\t\t\t\t5, \(\@2\) sig\/\@\(xx*\ L\)]; \n
              If[UnsameQ[rslp, 0], \nctorslp = ct\/\(\(\@2\) rslp\); \n
                ctsorslp = cts\/\(\(\@2\) rslp\); \n
                shadf = \(1\/2\) \((\(1\/\(\(\@\[Pi]\) ctorslp\)\) 
                          Exp[\(-ctorslp\^2\)] - Erfc[ctorslp])\); \n
                shadfs = \(1\/2\) \((\(1\/\(\(\@\[Pi]\) ctsorslp\)\) 
                          Exp[\(-ctsorslp\^2\)] - Erfc[ctsorslp])\); \n
                ShdwS = N[1\/\(1 + shadf + shadfs\)]; \nShdwS = 1; \n
                Print["\<Warning: RMS surface slope not available. Shadowing \
not used.\>"]];\ *) \), "\n", \(ShdwS = 1\), ";", "\n", 
            StyleBox[
              RowBox[{"iemmvv", "=", 
                RowBox[{
                "ShdwS", \(k\^2\/2\), \(Exp[\(-\[Sigma]\^2\) \((kz\^2 + 
                          ksz\^2)\)]\), 
                  RowBox[{
                    UnderoverscriptBox["\[Sum]", 
                      RowBox[{"n", "=", 
                        StyleBox["1",
