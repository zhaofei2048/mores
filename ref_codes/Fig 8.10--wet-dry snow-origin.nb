                        StyleBox[\(to\ use\ spherical\ coordinate\ in\ \
defining\ Phs\),
                          FontColor->RGBColor[1, 0, 0]], 
                        StyleBox[",",
                          FontColor->RGBColor[1, 0, 0]], 
                        StyleBox[" ",
                          FontColor->RGBColor[1, 0, 0]], 
                        StyleBox[\(we\ need\ to\ add\ 180\ to\ phs\),
                          FontColor->RGBColor[1, 0, 0]]}], "*)"}], 
                    "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", \(phh = 
                      0.75 \((1 + Cos[2\ phs\ Degree])\)\), ";", 
                    "\n", \(pvv = 
                      0.75 \((2\ \ st\^2\ so\^2 + \(cst\^2\) \(cso\^2\) \((1 \
+ Cos[2\ phs\ Degree])\) + 
                            4\ cst\ cso\ st\ so\ Cos[\((\ 
                                    phs + 180)\)\ Degree])\)\), ";", 
                    "\[IndentingNewLine]", \(pvvf = 
                      0.75 \((2\ \ st\^2\ so\^2 + \(cst\^2\) \(cso\^2\) \((1 \
+ Cos[2*0\ Degree])\) - 4\ cst\ cso\ st\ so\ )\)\), ";", "\n", 
                    "\n", \(volvv = 
                      css\ cst\ Tv\ Tvs\ al\ \((1 - 
                            Exp[\(-\(\(tau \((cso + 
                                        cst)\)\)\/\(cso\ cst\)\)\)])\) 
                        pvv/\((cso + cst)\)\), ";", 
                    "\n", \(volhh = 
                      css\ cst\ Th\ Ths\ al\ \((1 - 
                            Exp[\(-\(\(tau \((cso + 
                                        cst)\)\)\/\(cso\ cst\)\)\)])\) 
                        phh/\((cso + cst)\)\), ";", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                      StyleBox[\(Interaction\ terms\),
                        FontColor->RGBColor[1, 0, 0]], "*)"}], 
                    "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", \(If[
                      cso \[NotEqual] cst, \[IndentingNewLine]invv = 
                        css\ \ Tv\ \ Tvs\ al \((\((Exp[\(-tau\)/cso] - 
                                  Exp[\(-tau\)/cst])\)/\((cso - cst)\))\) 
                          Exp[\(-kl\^2\) \(sig2\^2\) \((cso + cst)\)\^2] 
                          pvvf \((cso\ Rvo\ Exp[\(-tau\)/cso] + 
                              cst\ Rvt\ Exp[\(-tau\)/cst])\), 
                      invv = 2\ cs\ \(Tv\^2\) 
                          al\ \((tau/
                              cst)\) \((Exp[\(-kl\^2\) \(sig2\^2\) \((cso + \
cst)\)\^2]\ Rvt)\)\ pvvf\ \ Exp[\(-2\) tau/cst]]\), ";", 
                    "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", \(If[
                      cso \[NotEqual] cst, \[IndentingNewLine]inhh = 
                        css\ \ Th\ \ Ths\ al \((\((Exp[\(-tau\)/cso] - 
                                  Exp[\(-tau\)/cst])\)/\((cso - cst)\))\) 
                          Exp[\(-kl\^2\) \(sig2\^2\) \((cso + cst)\)\^2] 
                          phh \((cso\ Rho\ Exp[\(-tau\)/cso] + 
                              cst\ Rht\ Exp[\(-tau\)/cst])\), 
                      inhh = 2\ cs\ \(Th\^2\) 
                          al\ \((tau/
                              cst)\) \((Exp[\(-kl\^2\) \(sig2\^2\) \((cso + \
cst)\)\^2]\ Rht)\)\ phh\ Exp[\(-2\) tau/cst]]\), ";", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                      
                      StyleBox[\(\(Calculate\ surface\ scattering\ from\ TOP\ \
 &\)\ BOTTOM\ boundaries . \ Call\ IEMM\),
                        FontColor->RGBColor[0, 0, 1]], "*)"}], 
                    "\[IndentingNewLine]", "\n", 
                    RowBox[{
                      StyleBox["stop",
                        FontSlant->"Italic"], 
                      StyleBox["=",
                        FontSlant->"Italic"], 
                      RowBox[{"IEMM", 
                        StyleBox["[",
                          FontColor->RGBColor[1, 0, 1]], \(fr, sig1, L1, 
                        theta, thetas, phs, er, 1, 1.5\), 
                        StyleBox["]",
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]]}]}], 
                    StyleBox[";",
                      FontSlant->"Italic",
                      FontColor->RGBColor[1, 0, 1]], "\[IndentingNewLine]", 
                    RowBox[{"stopv", "=", 
                      RowBox[{"stop", 
                        StyleBox["[",
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]], 
                        StyleBox[\([2]\),
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]], 
                        StyleBox["]",
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"stoph", "=", 
                      RowBox[{"stop", 
                        StyleBox["[",
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]], 
                        StyleBox[\([3]\),
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]], 
                        StyleBox["]",
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]]}]}], ";", 
                    "\[IndentingNewLine]", "  ", \(ebr = Re[erb/er]\), ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"sbot", "=", 
                      RowBox[{"IEMM", 
                        StyleBox["[",
                          FontColor->RGBColor[1, 0, 1]], \(fr, sig2, L2, 
                        thetat, thetao, phs, ebr, 1, 1.5\), 
                        StyleBox["]",
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]]}]}], 
                    StyleBox[";",
                      FontSlant->"Italic",
                      FontColor->RGBColor[1, 0, 1]], 
                    StyleBox["\[IndentingNewLine]",
                      FontSlant->"Italic",
                      FontColor->RGBColor[1, 0, 1]], 
                    RowBox[{
                      StyleBox["cov",
                        FontSlant->"Italic",
                        FontColor->RGBColor[1, 0, 1]], 
                      StyleBox["=",
                        FontSlant->"Italic",
                        FontColor->RGBColor[1, 0, 1]], 
                      
                      StyleBox[\(css\ \ Tv\ Tvs\ Exp[\(-tau\) \((1/cso + 
                                    1/cst)\)]/cst\),
                        FontSlant->"Italic"]}], 
                    StyleBox[";",
                      FontSlant->"Italic"], 
                    StyleBox["\[IndentingNewLine]",
                      FontSlant->"Italic"], 
                    
                    StyleBox[\(coh = 
                        css\ \ Th\ Ths\ Exp[\(-tau\) \((1/cso + 1/cst)\)]/
                            cst\),
                      FontSlant->"Italic"], 
                    StyleBox[";",
                      FontSlant->"Italic"], 
                    StyleBox["\[IndentingNewLine]",
                      FontSlant->"Italic"], 
                    RowBox[{
                      StyleBox["sbotv",
                        FontSlant->"Italic"], 
                      StyleBox["=",
                        FontSlant->"Italic"], 
                      RowBox[{
                        StyleBox["cov",
                          FontSlant->"Italic"], 
                        StyleBox["*",
                          FontSlant->"Italic"], 
                        RowBox[{
                          StyleBox["sbot",
                            FontSlant->"Italic"], 
                          StyleBox["[",
                            FontSlant->"Italic",
                            FontColor->RGBColor[1, 0, 1]], 
                          StyleBox[\([2]\),
                            FontSlant->"Italic",
                            FontColor->RGBColor[1, 0, 1]], 
                          StyleBox["]",
                            FontSlant->"Italic",
                            FontColor->RGBColor[1, 0, 1]]}]}]}], 
                    StyleBox[";",
                      FontSlant->"Italic"], 
                    StyleBox["\[IndentingNewLine]",
                      FontSlant->"Italic"], 
                    RowBox[{
                      StyleBox["sboth",
                        FontSlant->"Italic"], 
                      StyleBox["=",
                        FontSlant->"Italic"], 
                      RowBox[{
                        StyleBox["coh",
                          FontSlant->"Italic"], 
                        StyleBox["*",
                          FontSlant->"Italic"], 
                        RowBox[{"sbot", 
                          StyleBox["[",
                            FontSlant->"Italic",
                            FontColor->RGBColor[1, 0, 1]], 
                          StyleBox[\([3]\),
                            FontSlant->"Italic",
                            FontColor->RGBColor[1, 0, 1]], 
                          StyleBox["]",
                            FontSlant->"Italic",
                            FontColor->RGBColor[1, 0, 1]]}]}]}], 
                    StyleBox[";",
                      FontSlant->"Italic"], "\n", 
                    StyleBox["\[IndentingNewLine]",
                      FontSlant->"Italic"], 
                    RowBox[{"ssv", "=", 
                      RowBox[{
                        StyleBox["volvv",
                          FontSlant->"Italic"], 
                        StyleBox["+",
                          FontSlant->"Italic"], "invv", "+", 
                        StyleBox["stopv",
                          FontSlant->"Italic"], 
                        StyleBox["+",
                          FontSlant->"Italic"], 
                        StyleBox["sbotv",
                          FontSlant->"Italic"]}]}], 
                    ";", \( (*\(Print[{stopv, \ sbotv}];\)*) \), "\n", 
                    RowBox[{"ssh", "=", 
                      RowBox[{
                        StyleBox["volhh",
                          FontSlant->"Italic"], 
                        StyleBox["+",
                          FontSlant->"Italic"], "inhh", "+", 
                        StyleBox["stoph",
                          FontSlant->"Italic"], 
                        StyleBox["+",
                          FontSlant->"Italic"], 
                        StyleBox["sboth",
                          FontSlant->"Italic"]}]}], ";", 
                    "\[IndentingNewLine]", \(Rlvv = 10.0  Log[10. , ssv]\), 
                    ";", \(vv = 10.0  Log[10. , volvv]\), 
                    ";", \(vint = 10.0  Log[10. , invv]\), 
                    ";", \(stvv = 10.0  Log[10. , stopv]\), 
                    ";", \(sbvv = 10.0  Log[10. , sbotv]\), ";", 
                    "\[IndentingNewLine]", \(Rlhh = 10.0  Log[10. , ssh]\), 
                    ";", \(hh = 10.0  Log[10. , volhh]\), 
                    ";", \(hint = 10.0  Log[10. , inhh]\), 
                    ";", \(sthh = 10.0  Log[10. , stoph]\), 
                    ";", \(sbhh = 10.0  Log[10. , sboth]\), ";", "\n", 
                    "\[IndentingNewLine]", \(Return[{thetas, Rlvv, Rlhh, 
                        vv, \ hh, \ vint, hint, stvv, sthh, sbvv, sbhh, \ 
                        cov, coh}]\), ";"}]}], "]"}]}]}], ";"}], 
        "\[IndentingNewLine]", \(\(\(End[]\) \)\(;\)\(\(EndPackage[]\) \
\)\(;\)\(\[IndentingNewLine]\)\)}]}]], "Input",
  FontSize->18],

