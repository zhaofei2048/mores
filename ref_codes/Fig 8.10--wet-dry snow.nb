         RowBox[{"er", " ", "cs"}], "-", "rt"}], 
        RowBox[{
         RowBox[{"er", " ", "cs"}], "+", "rt"}]], "]"}]}], ";", 
     RowBox[{"Rhi", "=", 
      RowBox[{"N", "[", 
       FractionBox[
        RowBox[{"cs", "-", "rt"}], 
        RowBox[{"cs", "+", "rt"}]], "]"}]}], ";", "\[IndentingNewLine]", "\n",
      "\n", 
     RowBox[{"wvnb", "=", 
      RowBox[{"k", " ", 
       RowBox[{"\[Sqrt]", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"ss", " ", "cfs"}], "-", 
             RowBox[{"s", " ", "cf"}]}], ")"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"ss", " ", "sfs"}], "-", " ", 
             RowBox[{"s", " ", "sf"}]}], ")"}], "2"]}], ")"}]}]}]}], ";", 
     "\n", 
     RowBox[{"TS", "=", "1"}], ";", 
     RowBox[{"error", "=", 
      SuperscriptBox["10", "8"]}], ";", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"error", ">", 
        FractionBox["1", 
         SuperscriptBox["10", "8"]]}], ",", 
       RowBox[{
        RowBox[{"TS", "=", 
         RowBox[{"TS", "+", "1"}]}], ";", 
        RowBox[{"error", "=", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["ks", "2"], " ", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"cs", "+", "css"}], ")"}], "2"]}], ")"}], "TS"], 
          RowBox[{"TS", "!"}]]}], ";"}]}], "]"}], ";", "\n", 
     RowBox[{"spctrm", "=", 
      RowBox[{"Switch", "[", 
       RowBox[{"sp", ",", "\n", "\t\t\t           ", "1", ",", 
        RowBox[{"Do", "[", " ", 
         RowBox[{
          RowBox[{
