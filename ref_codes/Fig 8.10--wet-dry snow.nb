         RowBox[{"(", 
          RowBox[{"kz", "+", "ksz"}], ")"}], "n"], "fvv", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["\[Sigma]", "2"]}], "kz", " ", "ksz"}], "]"}]}], 
       "+", 
       FractionBox[
        RowBox[{
         RowBox[{
          SuperscriptBox["ksz", "n"], "Fvv"}], "+", 
         RowBox[{
          SuperscriptBox["kz", "n"], "Fvs"}]}], "2"]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"oIhh", "=", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"kz", "+", "ksz"}], ")"}], "n"], "fhh", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["\[Sigma]", "2"]}], "kz", " ", "ksz"}], "]"}]}], 
       "+", 
       FractionBox[
        RowBox[{
         RowBox[{
          SuperscriptBox["ksz", "n"], "Fhh"}], "+", 
         RowBox[{
          SuperscriptBox["kz", "n"], "Fhs"}]}], "2"]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"iemvv", "=", 
      StyleBox[
       RowBox[{"ShdwS", 
        FractionBox[
         SuperscriptBox["k", "2"], "2"], 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["\[Sigma]", "2"]}], 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["kz", "2"], "+", 
            SuperscriptBox["ksz", "2"]}], ")"}]}], "]"}], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"n", "=", 
           StyleBox["1",
            FontSlant->"Italic"]}], "TS"], 
         RowBox[{
          SuperscriptBox["\[Sigma]", 
           RowBox[{"2", "n"}]], 
          SuperscriptBox[
           RowBox[{"Abs", "[", 
            StyleBox["oIvv",
             FontSlant->"Italic"], 
            StyleBox["]",
             FontSlant->"Italic"]}], "2"], " ", 
          FractionBox[
           RowBox[{"w", "[", "n", "]"}], 
           RowBox[{"n", "!"}]]}]}]}],
       FontSlant->"Italic"]}], 
     StyleBox[";",
      FontSlant->"Italic"], 
     StyleBox["\[IndentingNewLine]",
      FontSlant->"Italic"], 
     RowBox[{"iemhh", "=", 
      StyleBox[
       RowBox[{"ShdwS", 
        FractionBox[
         SuperscriptBox["k", "2"], "2"], 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["\[Sigma]", "2"]}], 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["kz", "2"], "+", 
            SuperscriptBox["ksz", "2"]}], ")"}]}], "]"}], 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"n", "=", 
           StyleBox["1",
            FontSlant->"Italic"]}], "TS"], 
         RowBox[{
          SuperscriptBox["\[Sigma]", 
           RowBox[{"2", "n"}]], 
          SuperscriptBox[
           RowBox[{"Abs", "[", 
            StyleBox["oIhh",
             FontSlant->"Italic"], 
            StyleBox["]",
             FontSlant->"Italic"]}], "2"], " ", 
          FractionBox[
           RowBox[{"w", "[", "n", "]"}], 
           RowBox[{"n", "!"}]]}]}]}],
       FontSlant->"Italic"]}], 
     StyleBox[";",
      FontSlant->"Italic"], 
     StyleBox["\[IndentingNewLine]",
      FontSlant->"Italic"], 
     StyleBox["\[IndentingNewLine]",
      FontSlant->"Italic"], 
     RowBox[{"sov", "=", 
      RowBox[{"10", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"10", ",", 
         RowBox[{"N", "[", 
          StyleBox["iemvv",
           FontSlant->"Italic"], "]"}]}], "]"}]}]}], ";", "\n", 
     RowBox[{"soh", "=", 
      RowBox[{"10", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"10", ",", 
         RowBox[{"N", "[", 
          StyleBox[
           RowBox[{"iem", 
            StyleBox["hh",
             FontSlant->"Italic"]}]], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\n", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"ths", ",", "iemmvv", ",", "iemmhh", ",", "sov", ",", "soh"}], 
       "}"}], "]"}], ";"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"End", "[", "]"}], ";", 
