          SuperscriptBox["\[Sigma]", 
           RowBox[{"2", "n"}]], 
          SuperscriptBox[
           RowBox[{"Abs", "[", 
            StyleBox["oIvv",
             FontSlant->"Italic"], 
            StyleBox["]",
             FontSlant->"Italic"]}], "2"], " ", 
          FractionBox[
           RowBox[{"w", "[", "n", "]"}], 
