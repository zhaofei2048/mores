Cell[CellGroupData[{

Cell["\<\
Step 3. Load the Rayleigh Layer Scattering Program
(1) This is the Rayleigh layer model. It consists of a top surface  \
scattering term, a bottom surface scattering term, a layer volume scattering \
term and an interaction term.
(2) Exact calculation should use the real angle of transmision given in the \
program below.
er = relative complex dielectric constant of the layer;
erb=relative complex dielectric constant of the half-space below the layer;
\
\>", "Section",
 FontSize->18,ExpressionUUID->"edc3bf54-e680-47b4-ba15-55771eb0dc58"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Off", "[", 
     RowBox[{"General", "::", "\"\<spell1\>\""}], "]"}], ";", 
    RowBox[{"Off", "[", 
     RowBox[{"General", "::", "\"\<spell\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"BeginPackage", "[", 
     RowBox[{"\"\<Rlay`\>\"", ",", 
      RowBox[{"{", "\"\<IEMM`\>\"", "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Rlay", "::", "\"\<usage\>\""}], "=", 
     "\"\<Calculates Layer volume-surf scattering and interaction\>\""}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Begin", "[", "\"\<`private`\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Rlay", 
      StyleBox["[",
       FontColor->RGBColor[1, 0, 1]], 
      RowBox[{
      "fr_", ",", "al_", ",", "tau_", ",", "theta_", ",", "thetas_", ",", 
       "phs_", ",", "er_", ",", "erb_", ",", "sig1_", ",", "sig2_", ",", 
       "L1_", ",", "L2_", ",", "sp_"}], 
      StyleBox["]",
       FontSlant->"Italic",
       FontColor->RGBColor[1, 0, 1]]}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "\t", 
       RowBox[{
        RowBox[{"k", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2.0", " ", "Pi", " ", "fr"}], ")"}], "/", "30.0"}]}], ";", 
        RowBox[{"kl", "=", 
         RowBox[{"k", 
          SqrtBox[
           RowBox[{"Re", "[", "er", "]"}]]}]}], ";", "\n", "\t", "\n", "\t\t", 
        RowBox[{"cs", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Cos", "[", 
           RowBox[{"theta", " ", "Degree"}], "]"}], "]"}]}], ";", "\n", 
        "\t\t", 
        RowBox[{"s", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Sin", "[", 
           RowBox[{"theta", " ", "Degree"}], "]"}], "]"}]}], ";", "\n", 
        "\t\t", 
        RowBox[{"s2", "=", 
         SuperscriptBox["s", "2"]}], ";", "\n", "\t\t", 
        RowBox[{"cfs", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Cos", "[", 
           RowBox[{"phs", " ", "Degree"}], "]"}], "]"}]}], ";", "\n", "\t\t", 
        RowBox[{"sfs", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Sin", "[", 
           RowBox[{"phs", " ", "Degree"}], "]"}], "]"}]}], ";", "\n", "\t\t", 
        RowBox[{"css", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Cos", "[", 
           RowBox[{"thetas", " ", "Degree"}], "]"}], "]"}]}], ";", "\n", 
        "\t\t", 
        RowBox[{"ss", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Sin", "[", 
           RowBox[{"thetas", " ", "Degree"}], "]"}], "]"}]}], ";", "\n", 
        "\t\t", 
        RowBox[{"ss2", "=", 
         SuperscriptBox["ss", "2"]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         StyleBox[
          RowBox[{
           RowBox[{
           "Calculations", " ", "of", " ", "sine", " ", "and", " ", "cosine", 
            " ", "using", " ", "real"}], "-", 
           RowBox[{"thetat", " ", "and", " ", "real"}], "-", "thetao"}],
          FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"alf", "=", 
         RowBox[{
          RowBox[{"Im", "[", 
           SqrtBox["er"], "]"}], "//", "N"}]}], ";", " ", 
        RowBox[{"be", "=", 
         RowBox[{"Re", "[", 
          SqrtBox["er"], "]"}]}], ";", " ", 
        RowBox[{"p", "=", 
         RowBox[{"2", " ", "alf", "*", " ", "be"}]}], ";", " ", 
        RowBox[{"q", "=", 
         RowBox[{
          SuperscriptBox["be", "2"], "-", 
          SuperscriptBox["alf", "2"], "-", "s2"}]}], ";", 
        RowBox[{"qs", "=", 
         RowBox[{
          SuperscriptBox["be", "2"], "-", 
          SuperscriptBox["alf", "2"], "-", "ss2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tant", "=", 
         RowBox[{"1.414", " ", 
          RowBox[{"s", "/", 
           SqrtBox[
            RowBox[{"q", "+", 
             SqrtBox[
              RowBox[{
               SuperscriptBox["p", "2"], "+", 
               SuperscriptBox["q", "2"]}]]}]]}]}]}], ";", " ", 
        RowBox[{"thetat", "=", 
         RowBox[{
          RowBox[{"ArcTan", "[", "tant", "]"}], "*", 
          RowBox[{"180", "/", "\[Pi]"}]}]}], ";", " ", 
        RowBox[{"st", "=", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"thetat", " ", "Degree"}], "]"}], "//", "N"}]}], ";", 
        RowBox[{"cst", "=", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["st", "2"]}]]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tano", "=", 
         RowBox[{"1.414", " ", 
          RowBox[{"ss", "/", 
           SqrtBox[
            RowBox[{"q", "+", 
             SqrtBox[
              RowBox[{
               SuperscriptBox["p", "2"], "+", 
               SuperscriptBox["qs", "2"]}]]}]]}]}]}], ";", " ", 
        RowBox[{"thetao", "=", 
         RowBox[{
          RowBox[{"ArcTan", "[", "tano", "]"}], "*", 
          RowBox[{"180", "/", "\[Pi]"}]}]}], ";", " ", 
        RowBox[{"so", "=", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"thetao", " ", "Degree"}], "]"}], "//", "N"}]}], ";", 
        RowBox[{"cso", "=", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["so", "2"]}]]}], ";", "\[IndentingNewLine]", "  ", 
        "\n", 
        RowBox[{"(*", 
         StyleBox[
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Top", " ", "boundary"}], " ", "&"}], " ", "bottom", 
             " ", "reflectivity"}], " ", "&"}], " ", "transmissivity"}],
          FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", 
        "\t\t", 
        RowBox[{"rt", "=", 
         SqrtBox[
          RowBox[{"er", "-", 
           SuperscriptBox["s", "2"]}]]}], ";", 
        RowBox[{"rvi", "=", 
         RowBox[{"N", "[", 
          FractionBox[
           RowBox[{
            RowBox[{"er", " ", "cs"}], "-", "rt"}], 
           RowBox[{
            RowBox[{"er", " ", "cs"}], "+", "rt"}]], "]"}]}], ";", 
        RowBox[{"rhi", "=", 
         RowBox[{"N", "[", 
          FractionBox[
           RowBox[{"cs", "-", "rt"}], 
           RowBox[{"cs", "+", "rt"}]], "]"}]}], ";", 
        RowBox[{"Rv", "=", 
         SuperscriptBox[
          RowBox[{"Abs", "[", "rvi", "]"}], "2"]}], ";", 
        RowBox[{"Rh", "=", 
         SuperscriptBox[
          RowBox[{"Abs", "[", "rhi", "]"}], "2"]}], ";", 
        "\[IndentingNewLine]", "\t", 
        RowBox[{"rts", "=", 
         SqrtBox[
          RowBox[{"er", "-", 
           SuperscriptBox["ss", "2"]}]]}], ";", 
        RowBox[{"rvs", "=", 
         RowBox[{"N", "[", 
          FractionBox[
           RowBox[{
            RowBox[{"er", " ", "css"}], "-", "rts"}], 
           RowBox[{
            RowBox[{"er", " ", "css"}], "+", "rts"}]], "]"}]}], ";", 
        RowBox[{"rhs", "=", 
         RowBox[{"N", "[", 
          FractionBox[
           RowBox[{"css", "-", "rts"}], 
           RowBox[{"css", "+", "rts"}]], "]"}]}], ";", 
        RowBox[{"Rvs", "=", 
         SuperscriptBox[
          RowBox[{"Abs", "[", "rvs", "]"}], "2"]}], ";", 
        RowBox[{"Rhs", "=", 
         SuperscriptBox[
          RowBox[{"Abs", "[", "rhs", "]"}], "2"]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"rtbt", "=", 
         SqrtBox[
          RowBox[{
           FractionBox["erb", "er"], "-", 
           SuperscriptBox["st", "2"]}]]}], ";", 
        RowBox[{"rvt", "=", 
         RowBox[{"N", "[", 
          FractionBox[
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"erb", "/", "er"}], ")"}], " ", "cst"}], "-", "rtbt"}], 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"erb", "/", "er"}], ")"}], " ", "cst"}], "+", "rtbt"}]],
           "]"}]}], ";", 
        RowBox[{"rht", "=", 
         RowBox[{"N", "[", 
          FractionBox[
           RowBox[{"cst", "-", "rtbt"}], 
           RowBox[{"cst", "+", "rtbt"}]], "]"}]}], ";", 
        RowBox[{"Rvt", "=", 
         SuperscriptBox[
          RowBox[{"Abs", "[", "rvt", "]"}], "2"]}], ";", 
        RowBox[{"Rht", "=", 
         SuperscriptBox[
          RowBox[{"Abs", "[", "rht", "]"}], "2"]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rtbo", "=", 
         SqrtBox[
          RowBox[{
           FractionBox["erb", "er"], "-", 
           SuperscriptBox["so", "2"]}]]}], ";", 
        RowBox[{"rvo", "=", 
         RowBox[{"N", "[", 
          FractionBox[
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"erb", "/", "er"}], ")"}], " ", "cso"}], "-", "rtbo"}], 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"erb", "/", "er"}], ")"}], " ", "cso"}], "+", "rtbo"}]],
           "]"}]}], ";", 
        RowBox[{"rho", "=", 
         RowBox[{"N", "[", 
          FractionBox[
           RowBox[{"cso", "-", "rtbo"}], 
           RowBox[{"cso", "+", "rtbo"}]], "]"}]}], ";", 
        RowBox[{"Rvo", "=", 
         SuperscriptBox[
          RowBox[{"Abs", "[", "rvo", "]"}], "2"]}], ";", 
        RowBox[{"Rho", "=", 
         SuperscriptBox[
          RowBox[{"Abs", "[", "rho", "]"}], "2"]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Tv", "=", 
         RowBox[{"1", "-", "Rv"}]}], ";", " ", 
        RowBox[{"Th", "=", 
         RowBox[{"1", "-", "Rh"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Tvs", "=", 
         RowBox[{"1", "-", "Rvs"}]}], ";", " ", 
        RowBox[{"Ths", "=", 
         RowBox[{"1", "-", "Rhs"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{
            StyleBox["Rayleigh",
             FontColor->RGBColor[0, 0, 1]], 
            StyleBox[" ",
             FontColor->RGBColor[0, 0, 1]], 
            StyleBox["Phase",
             FontColor->RGBColor[0, 0, 1]], 
            StyleBox[" ",
             FontColor->RGBColor[0, 0, 1]], 
            StyleBox["functions",
             FontColor->RGBColor[0, 0, 1]], 
            StyleBox[" ",
             FontColor->RGBColor[0, 0, 1]], 
            StyleBox["and",
             FontColor->RGBColor[0, 0, 1]], 
            StyleBox[" ",
             FontColor->RGBColor[0, 0, 1]], 
            StyleBox["the",
             FontColor->RGBColor[0, 0, 1]], " ", 
            StyleBox["volume",
