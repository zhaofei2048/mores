                    RowBox[{"xx", " ", "n"}], "-", "1"}]], " ", 
                  RowBox[{"Gamma", "[", 
                   RowBox[{"xx", " ", "n"}], "]"}]}], ")"}]}], "]"}]}], "]"}],
            FontColor->RGBColor[0, 0, 1]]}], 
          StyleBox[",",
           FontColor->RGBColor[0, 0, 1]], 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", "TS", ",", "1"}], "}"}]}], "]"}], 
        StyleBox[",",
