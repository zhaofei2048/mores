              RowBox[{"Exp", "[", 
               RowBox[{"-", 
                FractionBox[
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"wvnb", " ", "L"}], ")"}], "2"], 
                 RowBox[{"4", " ", "n"}]]}], "]"}]}],
             FontColor->RGBColor[0, 0, 1]], 
            StyleBox["]",
             FontColor->RGBColor[0, 0, 1]]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", "TS", ",", "1"}], "}"}]}], "]"}], 
        StyleBox[",",
         FontColor->RGBColor[0, 0, 1]], "\[IndentingNewLine]", "3", ",", 
        RowBox[{"Do", "[", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"w", "[", "n", "]"}], "=", 
           StyleBox[
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"wvnb", "==", "0"}], ",", 
              FractionBox[
               SuperscriptBox["L", "2"], 
               RowBox[{
                RowBox[{"3", " ", "n"}], "-", "2"}]], ",", 
              RowBox[{"N", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  SuperscriptBox["L", "2"], " ", 
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"wvnb", " ", "L"}], ")"}], 
                   RowBox[{
                    RowBox[{"xx", " ", "n"}], "-", "1"}]], " ", 
                  RowBox[{"BesselK", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "xx"}], " ", "n"}], "+", "1"}], ",", 
