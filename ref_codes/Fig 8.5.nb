                RowBox[{"Log", "[", 
                  RowBox[{"10", ",", 
                    RowBox[{"N", "[", 
                      StyleBox["iemvv",
                        FontSlant->"Italic"], "]"}]}], "]"}]}]}], ";", "\n", 
            RowBox[{"soh", "=", 
              RowBox[{"10", " ", 
                RowBox[{"Log", "[", 
                  RowBox[{"10", ",", 
                    RowBox[{"N", "[", 
                      StyleBox[
                        RowBox[{"iem", 
                          StyleBox["hh",
                            FontSlant->"Italic"]}]], "]"}]}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            "\n", \(Return[{ths, iemmvv, iemmhh, sov, soh}]\), ";"}]}], 
        "]"}]}], "\n", \(End[]; EndPackage[]\)}], "Input",
