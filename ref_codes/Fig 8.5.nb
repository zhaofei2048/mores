Cell[BoxData[
    RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{\(Needs["\<Statistics`DataManipulation`\>"];\), 
        "\n", \(Needs["\<Graphics`MultipleListPlot`\>"];\), 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "\n", \(dav = {{{0, \(-6. \)}, ErrorBar[0.5]}, {{10, \(-7.0\)}, 
                ErrorBar[0.5]}, {{20, \(-7.2\)}, 
                ErrorBar[0.5]}, {{30, \(-7.8\)}, 
                ErrorBar[0.5]}, {{40, \(-7.9\)}, 
                ErrorBar[0.5]}, {{50, \(-9.2\)}, 
                ErrorBar[0.5]}, {{60, \(-10.2\)}, 
                ErrorBar[0.5]}, {{70, \(-12.2\)}, ErrorBar[0.5]}};\), "\n", 
        "\n", \(dah = {{{0, \(-6. \)}, ErrorBar[0.5]}, {{10, \(-7.0\)}, 
                ErrorBar[0.5]}, {{20, \(-7.2\)}, 
                ErrorBar[0.5]}, {{30, \(-7.8\)}, 
                ErrorBar[0.5]}, {{40, \(-7.9\)}, 
                ErrorBar[0.5]}, {{50, \(-9.2\)}, 
                ErrorBar[0.5]}, {{60, \(-10.2\)}, 
                ErrorBar[0.5]}, {{70, \(-12.2\)}, ErrorBar[0.5]}};\), "\n", 
        "\n", "\n", "\n", 
        RowBox[{
          RowBox[{"g1", "=", 
            RowBox[{"Graphics", "[", 
              RowBox[{"MultipleListPlot", "[", 
                RowBox[{
                  StyleBox["vv",
                    FontColor->RGBColor[0, 0, 1]], ",", 
                  StyleBox["hh",
                    FontColor->RGBColor[0, 0, 1]], ",", 
                  StyleBox["dav",
                    FontColor->RGBColor[0, 0, 1]], ",", "dah", ",", "\n", 
                  "\t", \(PlotStyle \[Rule] {Dashing[{0.03, 0.03}], 
                      Dashing[{0.01, 0.01}], {Hue[ .85]}, {Hue[ .3]}, {Hue[
                          0.5]}, {Hue[0.1]}}\), ",", "\n", 
                  "\t", \(AspectRatio \[Rule] 1\), ",", "\n", "\t", 
                  RowBox[{"PlotLegend", "\[Rule]", 
                    RowBox[{"{", 
                      
                      RowBox[{\(FontForm["\<vv\>", {"\<Arial\>", 14}]\), ",", 
                        
                        RowBox[{"FontForm", "[", 
                          RowBox[{"\"\<\!\(\*
StyleBox[\"hh\",\nFontColor->RGBColor[0, 0, 1]]\)\>\"", 
                            ",", \({"\<Arial\>", 14}\)}], "]"}], 
                        ",", \(FontForm["\<dav\>", {"\<Arial\>", 14}]\), ",", 
                        
                        RowBox[{"FontForm", "[", 
                          RowBox[{"\"\<\!\(\*
StyleBox[\"dah\",\nFontColor->RGBColor[0, 0, 1]]\)\>\"", 
                            ",", \({"\<Arial\>", 14}\)}], "]"}], ",", 
                        RowBox[{"FontForm", "[", 
                          RowBox[{"\"\<\!\(\*
StyleBox[\"vIEM\",\nFontColor->RGBColor[0, 0, 1]]\)\>\"", 
                            ",", \({"\<Arial\>", 14}\)}], "]"}], ",", 
                        RowBox[{"FontForm", "[", 
                          RowBox[{"\"\<\!\(\*
StyleBox[\"hIEM\",\nFontColor->RGBColor[0, 0, 1]]\)\>\"", 
                            ",", \({"\<Arial\>", 14}\)}], "]"}]}], "}"}]}], 
                  ",", "\n", "\t", \(PlotRange \[Rule] {\(-15\), \(-5\)}\), 
                  ",", 
                  StyleBox[\(DisplayFunction -> Identity\),
                    FontColor->RGBColor[0, 1, 0]], 
                  StyleBox[",",
                    FontColor->RGBColor[0, 1, 0]], "\n", 
                  "\t", \(SymbolShape \[Rule] {MakeSymbol[
                        RegularPolygon[5, 0]], 
                      MakeSymbol[RegularPolygon[4, 0]], PlotSymbol[Star, 5], 
                      PlotSymbol[Diamond, 5], 
                      MakeSymbol[RegularPolygon[3, 0]], 
                      MakeSymbol[RegularPolygon[6, 0]]}\), ",", "\n", 
                  "\t\t", \(PlotLabel \[Rule] 
                    FontForm["\<Scattering Coefficient\>", {"\<Arial\>", 
                        16}]\), ",", \(Frame \[Rule] True\), 
                  ",", \(Axes \[Rule] False\), ",", "\n", 
                  "\t", \(PlotJoined \[Rule] {True, True, False, False, True, 
                      True}\), 
                  ",", \(FrameLabel \[Rule] {FontForm["\<\[Theta]\>", \
{"\<Arial\>", 18}], FontForm[\*"\"\<\!\(\[Sigma]\^0\)\>\"", {"\<Arial\>", 
                          18}]}\), 
                  ",", \(Background \[Rule] GrayLevel[0.998]\), 
                  ",", \(DefaultFont \[Rule] 14\), 
                  ",", \(GridLines \[Rule] Automatic\), 
                  ",", \(RotateLabel \[Rule] False\)}], "]"}], "]"}]}], 
          ";"}]}]}]], "Input",
