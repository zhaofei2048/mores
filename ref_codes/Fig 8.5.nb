Cell[CellGroupData[{

Cell[TextData[{
  "Step 3. Load Rayleigh-layer program\n",
  StyleBox["(1) This is the Rayleigh layer model. It consists of a top \
surface  scattering term, a bottom surface scattering term, a layer volume \
scattering term and an interaction term.\n(2) Exact calculation should use \
the real angle of transmision given in the program below.\ner = relative \
complex dielectric constant of the layer;\nerb=relative complex dielectric \
constant of the half-space below the layer;\n",
    FontSize->14]
}], "Section",
  FontSize->18],

Cell[BoxData[
    RowBox[{"\[IndentingNewLine]", 
      RowBox[{
        RowBox[{
          
          RowBox[{\(Off[General::"\<spell1\>"]; 
            Off[General::"\<spell\>"]; \n\(BeginPackage["\<Rlay`\>", \
{"\<IEMM`\>", "\<Graphics`MultipleListPlot`\>"}];\)\), 
            "\n", \(Rlay::"\<usage\>" = "\<Calculates Layer volume-surf \
scattering and interaction\>";\), "\n", \(Begin["\<`private`\>"];\), "\n", 
            RowBox[{
              RowBox[{"Rlay", 
                StyleBox["[",
                  FontColor->RGBColor[1, 0, 1]], \(fr_, al_, tau_, theta_, 
                thetas_, phs_, er_, erb_, sig1_, sig2_, L1_, L2_, sp_\), 
                StyleBox["]",
                  FontSlant->"Italic",
                  FontColor->RGBColor[1, 0, 1]]}], ":=", 
              RowBox[{"Module", "[", 
                RowBox[{\({}\), ",", "\[IndentingNewLine]", "\t", 
                  
                  RowBox[{\(k = \((2.0\ Pi\ fr)\)/30.0\), 
                    ";", \(kl = k \@ Re[er]\), ";", "\n", "\t", "\n", 
                    "\t\t", \(cs = N[Cos[theta\ Degree]]\), ";", "\n", 
                    "\t\t", \(s = N[Sin[theta\ Degree]]\), ";", "\n", 
                    "\t\t", \(s2 = s\^2\), ";", "\n", 
                    "\t\t", \(cfs = N[Cos[phs\ Degree]]\), ";", "\n", 
                    "\t\t", \(sfs = N[Sin[phs\ Degree]]\), ";", "\n", 
                    "\t\t", \(css = N[Cos[thetas\ Degree]]\), ";", "\n", 
                    "\t\t", \(ss = N[Sin[thetas\ Degree]]\), ";", "\n", 
                    "\t\t", \(ss2 = ss\^2\), ";", "\[IndentingNewLine]", 
                    RowBox[{"(*", " ", 
                      
                      StyleBox[\(Calculations\ of\ sine\ and\ cosine\ using\ \
real - thetat\ and\ real - thetao\),
                        FontColor->RGBColor[0, 0, 1]], "*)"}], 
                    "\[IndentingNewLine]", \(alf = Im[\@er] // N\), ";", 
                    " ", \(be = Re[\@er]\), ";", " ", \(p = 2\ alf*\ be\), 
                    ";", " ", \(q = be\^2 - alf\^2 - s2\), 
                    ";", \(qs = be\^2 - alf\^2 - ss2\), ";", 
                    "\[IndentingNewLine]", \(tant = 
                      1.414\ s/\@\(q + \@\(p\^2 + q\^2\)\)\), ";", 
                    " ", \(thetat = ArcTan[tant]*180/\[Pi]\), ";", 
                    " ", \(st = Sin[thetat\ Degree] // N\), 
                    ";", \(cst = \@\(1 - st\^2\)\), ";", 
                    "\[IndentingNewLine]", \(tano = 
                      1.414\ ss/\@\(q + \@\(p\^2 + qs\^2\)\)\), ";", 
                    " ", \(thetao = ArcTan[tano]*180/\[Pi]\), ";", 
                    " ", \(so = Sin[thetao\ Degree] // N\), 
                    ";", \(cso = \@\(1 - so\^2\)\), ";", 
                    "\[IndentingNewLine]", "  ", "\n", 
                    RowBox[{"(*", 
                      
                      StyleBox[\(\(\(Top\ boundary\  &\)\ bottom\ \
reflectivity\  &\)\ transmissivity\),
                        FontColor->RGBColor[0, 0, 1]], "*)"}], 
                    "\[IndentingNewLine]", "\t\t", \(rt = \@\(er - s\^2\)\), 
                    ";", \(rvi = N[\(er\ cs - rt\)\/\(er\ cs + rt\)]\), 
                    ";", \(rhi = N[\(cs - rt\)\/\(cs + rt\)]\), 
                    ";", \(Rv = Abs[rvi]\^2\), ";", \(Rh = Abs[rhi]\^2\), ";",
                     "\[IndentingNewLine]", "\t", \(rts = \@\(er - ss\^2\)\), 
                    ";", \(rvs = N[\(er\ css - rts\)\/\(er\ css + rts\)]\), 
                    ";", \(rhs = N[\(css - rts\)\/\(css + rts\)]\), 
                    ";", \(Rvs = Abs[rvs]\^2\), ";", \(Rhs = Abs[rhs]\^2\), 
                    ";", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", \(rtbt = \@\(erb\/er - st\^2\)\), 
                    ";", \(rvt = 
                      N[\(\((erb/er)\)\ cst - rtbt\)\/\(\((erb/er)\)\ cst + \
rtbt\)]\), ";", \(rht = N[\(cst - rtbt\)\/\(cst + rtbt\)]\), 
                    ";", \(Rvt = Abs[rvt]\^2\), ";", \(Rht = Abs[rht]\^2\), 
                    ";", "\[IndentingNewLine]", \(rtbo = \@\(erb\/er - \
so\^2\)\), ";", \(rvo = 
                      N[\(\((erb/er)\)\ cso - rtbo\)\/\(\((erb/er)\)\ cso + \
rtbo\)]\), ";", \(rho = N[\(cso - rtbo\)\/\(cso + rtbo\)]\), 
                    ";", \(Rvo = Abs[rvo]\^2\), ";", \(Rho = Abs[rho]\^2\), 
                    ";", "\[IndentingNewLine]", \(Tv = 1 - Rv\), ";", 
                    " ", \(Th = 1 - Rh\), ";", 
                    "\[IndentingNewLine]", \(Tvs = 1 - Rvs\), ";", 
                    " ", \(Ths = 1 - Rhs\), ";", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                      RowBox[{
                        RowBox[{
                          RowBox[{
                            StyleBox["Rayleigh",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox[" ",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox["Phase",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox[" ",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox["functions",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox[" ",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox["and",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox[" ",
                              FontColor->RGBColor[0, 0, 1]], 
                            StyleBox["the",
                              FontColor->RGBColor[0, 0, 1]], " ", 
                            StyleBox["volume",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox[" ",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox["scattering",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox[" ",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox[\(terms . \ Due\),
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox[" ",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox["to",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox[" ",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox["difference",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox[" ",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox["in",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox[" ",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox["definition",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox[" ",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox["in",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox[" ",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox["Chandrasekar",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox[" ",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox["where",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox[" ",
                              FontColor->RGBColor[1, 0, 0]], 
                            StyleBox["phs",
                              FontColor->RGBColor[1, 0, 0]]}], 
                          StyleBox[" ",
                            FontColor->RGBColor[1, 0, 0]], 
                          StyleBox["=",
                            FontColor->RGBColor[1, 0, 0]], 
                          
                          StyleBox[\(0\ means\ the\ TR\ are\ together\ and\ \
phs = 180\ means\ TR\ are\ 180\ apart\),
                            FontColor->RGBColor[1, 0, 0]]}], 
                        StyleBox[",",
                          FontColor->RGBColor[1, 0, 0]], 
                        StyleBox[" ",
                          FontColor->RGBColor[1, 0, 0]], 
                        
                        StyleBox[\(to\ use\ spherical\ coordinate\ in\ \
defining\ Phs\),
                          FontColor->RGBColor[1, 0, 0]], 
                        StyleBox[",",
                          FontColor->RGBColor[1, 0, 0]], 
                        StyleBox[" ",
                          FontColor->RGBColor[1, 0, 0]], 
                        StyleBox[\(we\ need\ to\ add\ 180\ to\ phs\),
                          FontColor->RGBColor[1, 0, 0]]}], "*)"}], 
                    "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", \(phh = 
                      0.75 \((1 + Cos[2\ phs\ Degree])\)\), ";", 
                    "\n", \(pvv = 
                      0.75 \((2\ \ st\^2\ so\^2 + \(cst\^2\) \(cso\^2\) \((1 \
+ Cos[2\ phs\ Degree])\) + 
                            4\ cst\ cso\ st\ so\ Cos[\((\ 
                                    phs + 180)\)\ Degree])\)\), ";", 
                    "\[IndentingNewLine]", \(pvvf = 
                      0.75 \((2\ \ st\^2\ so\^2 + \(cst\^2\) \(cso\^2\) \((1 \
+ Cos[2*0\ Degree])\) - 4\ cst\ cso\ st\ so\ )\)\), ";", "\n", 
                    "\n", \(volvv = 
                      css\ cst\ Tv\ Tvs\ al\ \((1 - 
                            Exp[\(-\(\(tau \((cso + 
                                        cst)\)\)\/\(cso\ cst\)\)\)])\) 
                        pvv/\((cso + cst)\)\), ";", 
                    "\n", \(volhh = 
                      css\ cst\ Th\ Ths\ al\ \((1 - 
                            Exp[\(-\(\(tau \((cso + 
                                        cst)\)\)\/\(cso\ cst\)\)\)])\) 
                        phh/\((cso + cst)\)\), ";", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                      StyleBox[\(Interaction\ terms\),
                        FontColor->RGBColor[1, 0, 0]], "*)"}], 
                    "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", \(If[
                      cso \[NotEqual] cst, \[IndentingNewLine]invv = 
                        css\ \ Tv\ \ Tvs\ al \((\((Exp[\(-tau\)/cso] - 
                                  Exp[\(-tau\)/cst])\)/\((cso - cst)\))\) 
                          Exp[\(-kl\^2\) \(sig2\^2\) \((cso + cst)\)\^2] 
                          pvvf \((cso\ Rvo\ Exp[\(-tau\)/cso] + 
                              cst\ Rvt\ Exp[\(-tau\)/cst])\), 
                      invv = 2\ cs\ \(Tv\^2\) 
                          al\ \((tau/
                              cst)\) \((Exp[\(-kl\^2\) \(sig2\^2\) \((cso + \
cst)\)\^2]\ Rvt)\)\ pvvf\ \ Exp[\(-2\) tau/cst]]\), ";", 
                    "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", \(If[
                      cso \[NotEqual] cst, \[IndentingNewLine]inhh = 
                        css\ \ Th\ \ Ths\ al \((\((Exp[\(-tau\)/cso] - 
                                  Exp[\(-tau\)/cst])\)/\((cso - cst)\))\) 
                          Exp[\(-kl\^2\) \(sig2\^2\) \((cso + cst)\)\^2] 
                          phh \((cso\ Rho\ Exp[\(-tau\)/cso] + 
                              cst\ Rht\ Exp[\(-tau\)/cst])\), 
                      inhh = 2\ cs\ \(Th\^2\) 
                          al\ \((tau/
                              cst)\) \((Exp[\(-kl\^2\) \(sig2\^2\) \((cso + \
cst)\)\^2]\ Rht)\)\ phh\ Exp[\(-2\) tau/cst]]\), ";", "\[IndentingNewLine]", 
                    "\[IndentingNewLine]", 
                    RowBox[{"(*", 
                      
                      StyleBox[\(\(Calculate\ surface\ scattering\ from\ TOP\ \
 &\)\ BOTTOM\ boundaries . \ Call\ IEMM\),
                        FontColor->RGBColor[0, 0, 1]], "*)"}], 
                    "\[IndentingNewLine]", "\n", 
                    RowBox[{
                      StyleBox["stop",
                        FontSlant->"Italic"], 
                      StyleBox["=",
                        FontSlant->"Italic"], 
                      RowBox[{"IEMM", 
                        StyleBox["[",
                          FontColor->RGBColor[1, 0, 1]], \(fr, sig1, L1, 
                        theta, thetas, phs, er, 1, 1.5\), 
                        StyleBox["]",
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]]}]}], 
                    StyleBox[";",
                      FontSlant->"Italic",
                      FontColor->RGBColor[1, 0, 1]], "\[IndentingNewLine]", 
                    RowBox[{"stopv", "=", 
                      RowBox[{"stop", 
                        StyleBox["[",
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]], 
                        StyleBox[\([2]\),
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]], 
                        StyleBox["]",
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]]}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"stoph", "=", 
                      RowBox[{"stop", 
                        StyleBox["[",
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]], 
                        StyleBox[\([3]\),
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]], 
                        StyleBox["]",
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]]}]}], ";", 
                    "\[IndentingNewLine]", "  ", \(ebr = Re[erb/er]\), ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"sbot", "=", 
                      RowBox[{"IEMM", 
                        StyleBox["[",
                          FontColor->RGBColor[1, 0, 1]], \(fr, sig2, L2, 
                        thetat, thetao, phs, ebr, 1, 1.5\), 
                        StyleBox["]",
                          FontSlant->"Italic",
                          FontColor->RGBColor[1, 0, 1]]}]}], 
                    StyleBox[";",
                      FontSlant->"Italic",
                      FontColor->RGBColor[1, 0, 1]], 
                    StyleBox["\[IndentingNewLine]",
                      FontSlant->"Italic",
                      FontColor->RGBColor[1, 0, 1]], 
                    RowBox[{
                      StyleBox["cov",
                        FontSlant->"Italic",
                        FontColor->RGBColor[1, 0, 1]], 
                      StyleBox["=",
                        FontSlant->"Italic",
                        FontColor->RGBColor[1, 0, 1]], 
                      
                      StyleBox[\(css\ \ Tv\ Tvs\ Exp[\(-tau\) \((1/cso + 
                                    1/cst)\)]/cst\),
                        FontSlant->"Italic"]}], 
                    StyleBox[";",
                      FontSlant->"Italic"], 
                    StyleBox["\[IndentingNewLine]",
                      FontSlant->"Italic"], 
                    
                    StyleBox[\(coh = 
                        css\ \ Th\ Ths\ Exp[\(-tau\) \((1/cso + 1/cst)\)]/
                            cst\),
                      FontSlant->"Italic"], 
                    StyleBox[";",
                      FontSlant->"Italic"], 
                    StyleBox["\[IndentingNewLine]",
                      FontSlant->"Italic"], 
                    RowBox[{
                      StyleBox["sbotv",
                        FontSlant->"Italic"], 
                      StyleBox["=",
                        FontSlant->"Italic"], 
                      RowBox[{
                        StyleBox["cov",
                          FontSlant->"Italic"], 
                        StyleBox["*",
                          FontSlant->"Italic"], 
                        RowBox[{
                          StyleBox["sbot",
                            FontSlant->"Italic"], 
                          StyleBox["[",
                            FontSlant->"Italic",
                            FontColor->RGBColor[1, 0, 1]], 
                          StyleBox[\([2]\),
                            FontSlant->"Italic",
                            FontColor->RGBColor[1, 0, 1]], 
                          StyleBox["]",
                            FontSlant->"Italic",
                            FontColor->RGBColor[1, 0, 1]]}]}]}], 
                    StyleBox[";",
                      FontSlant->"Italic"], 
                    StyleBox["\[IndentingNewLine]",
                      FontSlant->"Italic"], 
                    RowBox[{
                      StyleBox["sboth",
                        FontSlant->"Italic"], 
                      StyleBox["=",
                        FontSlant->"Italic"], 
                      RowBox[{
                        StyleBox["coh",
                          FontSlant->"Italic"], 
                        StyleBox["*",
                          FontSlant->"Italic"], 
                        RowBox[{"sbot", 
                          StyleBox["[",
                            FontSlant->"Italic",
                            FontColor->RGBColor[1, 0, 1]], 
                          StyleBox[\([3]\),
                            FontSlant->"Italic",
                            FontColor->RGBColor[1, 0, 1]], 
                          StyleBox["]",
                            FontSlant->"Italic",
                            FontColor->RGBColor[1, 0, 1]]}]}]}], 
                    StyleBox[";",
                      FontSlant->"Italic"], "\n", 
                    StyleBox["\[IndentingNewLine]",
                      FontSlant->"Italic"], 
                    RowBox[{"ssv", "=", 
                      RowBox[{
                        StyleBox["volvv",
                          FontSlant->"Italic"], 
                        StyleBox["+",
                          FontSlant->"Italic"], "invv", "+", 
                        StyleBox["stopv",
                          FontSlant->"Italic"], 
                        StyleBox["+",
                          FontSlant->"Italic"], 
                        StyleBox["sbotv",
                          FontSlant->"Italic"]}]}], 
                    ";", \( (*\(Print[{stopv, \ sbotv}];\)*) \), "\n", 
                    RowBox[{"ssh", "=", 
                      RowBox[{
                        StyleBox["volhh",
                          FontSlant->"Italic"], 
                        StyleBox["+",
                          FontSlant->"Italic"], "inhh", "+", 
                        StyleBox["stoph",
                          FontSlant->"Italic"], 
                        StyleBox["+",
                          FontSlant->"Italic"], 
                        StyleBox["sboth",
                          FontSlant->"Italic"]}]}], ";", 
                    "\[IndentingNewLine]", \(Rlvv = 10.0  Log[10. , ssv]\), 
                    ";", \(vv = 10.0  Log[10. , volvv]\), 
                    ";", \(vint = 10.0  Log[10. , invv]\), 
                    ";", \(stvv = 10.0  Log[10. , stopv]\), 
                    ";", \(sbvv = 10.0  Log[10. , sbotv]\), ";", 
                    "\[IndentingNewLine]", \(Rlhh = 10.0  Log[10. , ssh]\), 
                    ";", \(hh = 10.0  Log[10. , volhh]\), 
                    ";", \(hint = 10.0  Log[10. , inhh]\), 
                    ";", \(sthh = 10.0  Log[10. , stoph]\), 
                    ";", \(sbhh = 10.0  Log[10. , sboth]\), ";", "\n", 
                    "\[IndentingNewLine]", \(Return[{thetas, Rlvv, Rlhh, 
                        vv, \ hh, \ vint, hint, stvv, sthh, sbvv, sbhh, \ 
                        cov, coh}]\), ";"}]}], "]"}]}]}], ";"}], 
        "\[IndentingNewLine]", \(\(\(End[]\) \)\(;\)\(\(EndPackage[]\) \
\)\(;\)\(\[IndentingNewLine]\)\)}]}]], "Input",
  FontSize->18]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Step 4 (a). Compute backscattering for alfalfa-short--- wet ground 
      (see p. 2096 vol. 3 for estimating soil er)\
\>", "Section",
  FontSize->18],

Cell[CellGroupData[{

Cell[BoxData[{
    RowBox[{
      RowBox[{
        StyleBox["fr",
          FontColor->RGBColor[0, 0, 1]], "=", "13"}], ";", 
      "  ", \(al = 0.175\), ";", \(tau = 0.45\), ";", " ", \(phs = 180\), 
      ";"}], "\n", 
    RowBox[{
      RowBox[{
        RowBox[{
          StyleBox["theta",
            FontColor->RGBColor[0, 0, 1]], "=", 
          StyleBox["thetas",
            FontColor->RGBColor[1, 0, 0]]}], ";", 
        RowBox[{
          StyleBox["er",
            FontColor->RGBColor[0, 0, 1]], "=", 
          StyleBox[\(1.2 - I\ 0.01\),
            FontColor->RGBColor[1, 0, 0]]}], ";", 
        RowBox[{
          StyleBox["erb",
            FontColor->RGBColor[0, 0, 1]], "=", \(15.0 - I\ 4\)}], ";", " ", 
        RowBox[{
          StyleBox["sig1",
            FontColor->RGBColor[0, 0, 1]], "=", 
          StyleBox[".15",
            FontColor->RGBColor[1, 0, 0]]}], ";", 
        RowBox[{
          StyleBox["sig2",
            FontColor->RGBColor[0, 0, 1]], "=", 
          StyleBox[
            RowBox[{"0", 
              StyleBox[".15",
                FontColor->RGBColor[1, 0, 0]]}]]}], ";", " ", \(L1 = 1.5\), 
        ";", " ", \(L2 = 1.5\), ";", \(sp = 1\), ";"}], "\n"}], "\n", 
    RowBox[{
      RowBox[{
        RowBox[{"start", 
          StyleBox["=",
            FontColor->GrayLevel[0]], 
          StyleBox["0.010",
            FontColor->GrayLevel[0]]}], ";", 
        RowBox[{"end", 
          StyleBox["=",
            FontColor->GrayLevel[0]], 
          StyleBox[
            RowBox[{
              StyleBox["7",
                FontColor->GrayLevel[0]], "0.01"}]]}], ";", \(step = 5\), 
        ";"}], "\[IndentingNewLine]"}], "\n", 
    RowBox[{
      RowBox[{"outp", "=", 
        RowBox[{"Table", "[", 
          RowBox[{
            RowBox[{"Rlay", 
              StyleBox["[",
                FontColor->RGBColor[1, 0, 1]], \(fr, al, tau, theta, thetas, 
              phs, er, erb/er, sig1, sig2, L1, L2, sp\), 
              StyleBox["]",
                FontSlant->"Italic",
                FontColor->RGBColor[1, 0, 1]]}], ",", 
            RowBox[{"{", 
              RowBox[{"thetas", 
                StyleBox[",",
                  FontColor->GrayLevel[0]], 
                StyleBox["start",
                  FontColor->GrayLevel[0]], 
                StyleBox[",",
                  FontColor->GrayLevel[0]], 
                StyleBox["end",
                  FontColor->GrayLevel[0]], 
                StyleBox[",",
                  FontColor->GrayLevel[0]], 
                StyleBox["step",
                  FontColor->GrayLevel[0]]}], "}"}]}], "]"}]}], 
      ";"}], "\n", \(vv = 
        Map[{#[\([1]\)], #[\([2]\)]} &, outp];\), "\n", \(hh = 
        Map[{#[\([1]\)], #[\([3]\)]} &, 
          outp];\), "\[IndentingNewLine]", \(vov = 
        Map[{#[\([1]\)], #[\([4]\)]} &, outp];\), "\n", \(voh = 
        Map[{#[\([1]\)], #[\([5]\)]} &, 
          outp];\), "\[IndentingNewLine]", \(inv = 
        Map[{#[\([1]\)], #[\([6]\)]} &, outp];\), "\n", \(inh = 
        Map[{#[\([1]\)], #[\([7]\)]} &, 
          outp];\), "\[IndentingNewLine]", \(stv = 
        Map[{#[\([1]\)], #[\([8]\)]} &, outp];\), "\n", \(sth = 
        Map[{#[\([1]\)], #[\([9]\)]} &, outp];\), "\n", \(sbv = 
        Map[{#[\([1]\)], #[\([10]\)]} &, outp];\), "\n", \(sbh = 
        Map[{#[\([1]\)], #[\([11]\)]} &, 
          outp];\), "\[IndentingNewLine]", \(cov = 
        Map[{#[\([1]\)], #[\([12]\)]} &, outp];\), "\n", 
    RowBox[{\(coh = Map[{#[\([1]\)], #[\([13]\)]} &, outp];\), 
      "\[IndentingNewLine]"}], "\[IndentingNewLine]", \
\(Needs["\<Statistics`DataManipulation`\>"];\), "\n", 
    RowBox[{\(Needs["\<Graphics`MultipleListPlot`\>"];\), 
      "\n"}], "\n", \(Print[
        TableForm[{vv, vov, inv, stv, sbv}, 
          TableHeadings \[Rule] {{\*"\"\<VV \!\(\[Sigma]\^0\)\>\""}, \
{"\<Layer\>"}}]];\), "\n", \(Print[
        TableForm[{hh, voh, inh, sth, sbh}, 
          TableHeadings \[Rule] {{\*"\"\<HH \!\(\[Sigma]\^0\)\>\""}, \
{"\<Layer\>"}}]];\), "\[IndentingNewLine]", "Null"}], "Input",
  FontSize->18],

